{
	"name": "wahlergebnisse",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Wahlergebnisse in Niedersachsen – Live-Auswertung für den Wahlabend und Rückblick auf frühere Kommunalwahlen. Privates Angebot ohne Gewähr.",
	"scripts": {
		"dev": "astro dev",
		"check": "astro check",
		"build": "astro build",
		"start": "node --experimental-strip-types server/main.ts",
		"poll": "node --experimental-strip-types server/poll.ts",
		"schnappschuss": "node --experimental-strip-types scripts/schnappschuss.ts",
		"demo-bestand": "node --experimental-strip-types scripts/demo-bestand.ts",
		"demo-messung": "node --experimental-strip-types --expose-gc scripts/demo-messung.ts",
		"kassetten": "KASSETTEN=neu vitest run test/ansage-kette.test.ts",
		"test": "vitest run",
		"e2e": "astro build && node scripts/freie-ports.mjs npx playwright test",
		"e2e:ci": "node scripts/freie-ports.mjs npx playwright test",
		"build:e2e": "astro build",
		"ci": "biome ci --diagnostic-level=error ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9",
		"@astrojs/node": "^9.5.5",
		"@astrojs/preact": "^4",
		"@astrojs/tailwind": "^5",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@tailwindcss/typography": "^0.5",
		"astro": "^5",
		"daisyui": "^4",
		"leaflet": "^1.9.4",
		"preact": "^10",
		"tailwindcss": "^3",
		"typescript": "^5",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4",
		"@playwright/test": "^1.50",
		"@types/leaflet": "^1.9",
		"@types/node": "^22",
		"nock": "^14.0.17",
		"vitest": "^4.1.11"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/levino/wahlergebnisse"
	}
}
