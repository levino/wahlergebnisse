---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import {
	TERMINE,
	type Termin,
	istLive,
	terminGiltFuerBehoerde,
	terminGiltFuerKreis,
} from "../data/termine.ts";
import type { Kreis } from "../data/kreise.ts";
import { behoerdePfad, kreisPfad, terminPfad } from "../lib/pfade.ts";
import KreisWechsel from "../components/KreisWechsel.astro";
import { formatUhrzeit } from "../lib/zahlen.ts";
import { bereichAusPfad, bereichsVersion } from "../lib/stand.ts";
import { QUELLCODE_URL } from "../data/quellcode.ts";
import { basisUrl } from "../lib/http.ts";
import { DEMO_HINWEIS, demoAn } from "../lib/demo.ts";

interface Props {
	title: string;
	description?: string;
	/** Kreis, in dem man gerade unterwegs ist – für Titel und Umschalter */
	kreis?: Kreis;
	/** Aktueller Termin (für Live-Aktualisierung und Navigation) */
	termin?: Termin;
	/** Brotkrumen unterhalb des Headers */
	pfad?: Array<{ titel: string; href?: string }>;
	/** Breite Darstellung (Karten) */
	breit?: boolean;
}

const {
	title,
	kreis,
	description = kreis
		? `Wahlergebnisse im ${kreis.name} – Kreistag, Räte und Ortsräte, live am Wahlabend.`
		: "Kommunalwahlergebnisse der niedersächsischen Landkreise und kreisfreien Städte.",
	termin,
	pfad = [],
	breit = false,
} = Astro.props;
const marke = kreis
	? `Wahlergebnisse ${kreis.name}`
	: "Wahlergebnisse Niedersachsen";
const live = Boolean(termin && istLive(termin));
// Der Stand gilt für den Ausschnitt, den diese Seite zeigt – nicht für ganz
// Niedersachsen. Sonst meldete jede Seite „neu“, sobald irgendein Kreis etwas
// gemeldet hat (siehe src/lib/stand.ts).
const bereich = bereichAusPfad(Astro.url.pathname);
// Die Kopfzeile zeigt die Termine **der Ebene, auf der man gerade steht** –
// derselbe Ausschnitt, an dem auch der Stand hängt. Auf einer Behördenseite
// sind das die Wahltage dieser Wahlleitung (Bürgermeisterwahl 2018 in Bad
// Salzdetfurth), auf Kreisebene nur die der Kreisbehörde.
//
// Vorher genügte es, dass irgendwer im Kreisgebiet einen Termin führte: Die
// Kopfzeile des Landkreises Hildesheim bot sieben Wahltage an, fünf davon
// Wahlen einer einzigen Gemeinde, und führte auf Kreis-Terminseiten, auf
// denen nichts stand.
const eigeneBehoerde = kreis?.behoerden.find((b) => b.ags === bereich.behoerde);
const termine = kreis
	? TERMINE.filter((t) =>
			eigeneBehoerde
				? terminGiltFuerBehoerde(t, kreis, eigeneBehoerde)
				: terminGiltFuerKreis(t, kreis.slug),
		)
	: [];
// Und die Verweise bleiben auf dieser Ebene: Wer in Bad Salzdetfurth steht und
// dort auf „Bürgermeisterwahl 2018“ klickt, will die Zahlen dieser Stadt sehen
// – der Weg über die Kreisseite führte für so einen Termin ins Leere.
const terminZiel = (id: string): string =>
	kreis
		? eigeneBehoerde
			? behoerdePfad(kreis.slug, id, eigeneBehoerde.slug)
			: terminPfad(kreis.slug, id)
		: "/";
const stand = termin ? bereichsVersion(termin.id, bereich) : "";
// Adresse, unter der die Seite sich neue Stände zustellen lässt (SSE, siehe
// server/live.ts). Nur für Live-Termine – Archivzahlen ändern sich nicht mehr.
const liveUrl =
	live && termin
		? `/api/live?${new URLSearchParams({
				termin: termin.id,
				...(bereich.kreis ? { kreis: bereich.kreis.slug } : {}),
				...(bereich.behoerde ? { behoerde: bereich.behoerde } : {}),
			})}`
		: "";
const documentTitle = `${title} | ${marke}`;
// Eigene Adresse der Seite. Hinter dem Proxy sieht der Server nur localhost,
// deshalb kommt die Basis aus der Konfiguration (siehe lib/http.ts).
const seitenUrl = new URL(Astro.url.pathname, basisUrl(Astro.site, Astro.url))
	.href;
// Generalprobe: Dann trägt jede Seite den Hinweis, und keine davon gehört in
// einen Suchindex (siehe lib/demo.ts).
const demo = demoAn();
---

<!doctype html>
<html lang="de" data-theme="cdu">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{demo ? `DEMO · ${documentTitle}` : documentTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={seitenUrl} />
		<meta property="og:site_name" content={marke} />
		<meta property="og:locale" content="de_DE" />
		<link rel="canonical" href={seitenUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="robots" content={demo ? "noindex, nofollow" : "index, follow"} />
		{/* Seitenwechsel ohne vollen Neuaufbau: die Karte bleibt dabei stehen
		    und fliegt zum neuen Gebiet, statt neu zu laden. */}
		<ClientRouter />
	</head>
	<body class="min-h-screen flex flex-col bg-base-200 text-unionsschwarz font-sans">
		{/* Der Demo-Hinweis steht über allem und bleibt auch im Vollbild stehen.
		    Er ist bewusst nicht wegzuklicken: Eine Seite, die echt aussieht und
		    es nicht ist, muss das an jeder Stelle sagen, an der jemand hinsieht
		    – und am Beamer sieht man nur, was im Bild ist. */}
		{demo && (
			<aside class="bg-unionsgold text-unionsschwarz" role="note">
				<p class="mx-auto max-w-[1600px] px-4 py-2 text-sm font-semibold flex flex-wrap items-baseline gap-x-2">
					<span class="uppercase tracking-wide">Demo</span>
					<span class="font-normal">{DEMO_HINWEIS}</span>
				</p>
			</aside>
		)}
		{/* Reißt die Zustellung ab, gehört das ins Bild – auch und gerade im
		    Vollbild am Beamer. Eine Leinwand, die stehengebliebene Zahlen zeigt
		    und dabei „Live" behauptet, ist schlimmer als eine leere: Im Saal
		    wird auf sie gezeigt und aus ihr vorgelesen. Der Balken sitzt
		    deshalb über allem, ist nicht wegzuklicken und verschwindet von
		    selbst, sobald die Leitung zurück ist. */}
		<div class="abriss-banner" role="alert">
			<span class="abriss-punkt" aria-hidden="true"></span>
			<span class="abriss-text">
				<strong>Keine Verbindung zum Server.</strong>
				Die Zahlen können veraltet sein – es wird weiter versucht.
			</span>
			<button type="button" class="abriss-knopf" data-abriss="neuladen">Neu laden</button>
		</div>
		{/* `nur-fenster` markiert alles, was am Beamer im Vollbild weicht (siehe
		    Dashboard.astro). Die Standanzeige bleibt bewusst stehen: Eine Seite,
		    die stillsteht und dabei „Live“ behauptet, ist das Schlechteste, was
		    hier passieren kann – im Vollbild erst recht. */}
		<header class="bg-rhoendorf text-white">
			<div class:list={["mx-auto px-4 py-3 flex flex-wrap items-center gap-x-6 gap-y-2", breit ? "max-w-[1600px]" : "max-w-7xl"]}>
				<a href={kreis ? kreisPfad(kreis.slug) : "/"} class="nur-fenster flex items-center gap-3 font-bold tracking-wide text-lg min-w-0">
					<span class="inline-block w-3 h-6 bg-cadenabbia shrink-0" aria-hidden="true"></span>
					<span class="truncate">Wahlergebnisse</span>
				</a>
				{/* Der Kreis ist keine Brotkrumen-Ebene, sondern der Rahmen der
				    Arbeit – deshalb steht er als Umschalter im Kopf. Auf der
				    Auswahlseite selbst wäre er doppelt. */}
				{kreis && <div class="nur-fenster contents"><KreisWechsel aktuell={kreis} /></div>}
				<nav class:list={["nur-fenster flex flex-wrap items-center gap-1 text-sm", termine.length === 0 && "hidden"]} aria-label="Wahltermine">
					{kreis && termine.map((t) => (
						<a href={terminZiel(t.id)} class:list={["px-3 py-1.5 rounded-sm hover:bg-white/15", termin?.id === t.id && "bg-white/20 font-semibold"]}>
							{t.titel}
							{t.live && <span class="ml-1 inline-block w-2 h-2 rounded-full bg-red-500 align-middle" title="Live-Termin"></span>}
						</a>
					))}
				</nav>
				{/* Standanzeige. Am Wahlabend läuft die Seite auf einem Beamer:
				    Sie muss aus einigen Metern lesbar sein und vor allem zeigen,
				    wenn die Zustellung abgerissen ist – eine Seite, die
				    stillsteht und dabei „Live“ behauptet, ist das Schlechteste,
				    was hier passieren kann. Die Zustände stehen in
				    data-zustand, die Farben und das, was sichtbar ist, hängen
				    unten im <style> daran. */}
				<div class="sm:ml-auto min-w-0" id="stand-anzeige" role="status"
					data-live={live ? "1" : "0"}
					data-termin={termin?.id ?? ""}
					data-version={stand}
					data-live-url={liveUrl}
					data-zustand={live ? "verbindet" : "archiv"}>
					{termin && (
						<p class="stand">
							<span class="stand-punkt" aria-hidden="true"></span>
							<span class="stand-lage">{live ? "Live" : "Archiv"}</span>
							<span class="stand-abriss">Verbindung unterbrochen</span>
							<span class="stand-zeit">
								{stand
									? <>Stand <span class="stand-uhr">{formatUhrzeit(stand)}</span></>
									: "noch keine Zahlen"}
							</span>
							{/* „geprüft“ füllt die Zustellung: Sie kennt den Zeitpunkt
						    für *diesen* Kreis, während `zuletztGeprueft` für den
						    ganzen Lauf über Niedersachsen gilt und einen selten
						    abgefragten Kreis frischer aussehen ließe, als er ist. */}
						{live && <span class="stand-geprueft"></span>}
						</p>
					)}
				</div>
			</div>
			{pfad.length > 0 && (
				<div class="nur-fenster bg-black/15">
					<nav class:list={["mx-auto px-4 py-1.5 text-sm flex flex-wrap items-center gap-1 opacity-90", breit ? "max-w-[1600px]" : "max-w-7xl"]} aria-label="Brotkrumen">
						{pfad.map((p, i) => (
							<>
								{i > 0 && <span class="opacity-50 px-1" aria-hidden="true">/</span>}
								{p.href ? <a href={p.href} class="hover:underline">{p.titel}</a> : <span class="font-semibold">{p.titel}</span>}
							</>
						))}
					</nav>
				</div>
			)}
		</header>

		<main class:list={["flex-1 mx-auto w-full px-4 py-6", breit ? "max-w-[1600px]" : "max-w-7xl"]}>
			<slot />
		</main>

		<footer class="nur-fenster bg-rhoendorf text-white/80 text-sm py-8 mt-8">
			<div class="mx-auto max-w-7xl px-4 grid grid-cols-1 gap-6 md:grid-cols-3">
				<div>
					<p class="font-bold text-white">Privates Angebot</p>
					<p class="mt-1">Eigene Auswertung der amtlichen Schnellmeldungen, ohne Gewähr und ohne Haftung. Maßgeblich sind allein die amtlichen Bekanntmachungen der Wahlleitungen.</p>
					<p class="mt-2"><a href="/ueber" class="underline">Worum es geht</a> · <a href="/rechtliches" class="underline">Rechtliches</a></p>
				</div>
				<div>
					<p class="font-bold text-white">Datenquellen</p>
					<ul class="mt-1 space-y-1">
						<li>Ergebnisse: Wahlpräsentationen der Wahlleitungen (votemanager)</li>
						<li>Gemeindegrenzen: © GeoBasis-DE / <a href="https://gdz.bkg.bund.de/" class="underline">BKG</a> (VG250, dl-de/by-2-0)</li>
						<li>Gemarkungen: © <a href="https://opengeodata.lgln.niedersachsen.de/" class="underline">LGLN</a> (dl-de/by-2-0)</li>
						<li>Ortsteile, Adressen, Kartenhintergrund: © <a href="https://www.openstreetmap.org/copyright" class="underline">OpenStreetMap</a>-Mitwirkende (ODbL)</li>
					</ul>
				</div>
				<div>
					<p class="font-bold text-white">Technik</p>
					<p class="mt-1">Die Schnellmeldungen werden am Wahlabend alle paar Minuten abgeholt; neue Zahlen des angesehenen Kreises stellt der Server der offenen Seite von selbst zu, die sich dann still erneuert. Sitzverteilungen vor dem vollständigen Ergebnis sind Hochrechnungen nach Hare-Niemeyer.</p>
					<p class="mt-2"><a href="/api" class="underline">Offene API (JSON, CSV, GeoJSON, MCP)</a>{QUELLCODE_URL && (<>{" · "}<a href={QUELLCODE_URL} class="underline">Quellcode auf GitHub</a></>)}</p>
				</div>
			</div>
		</footer>

		{/* Standanzeige: eigene Regeln statt Hilfsklassen, weil die Zustände aus
		    dem Skript kommen (data-zustand) und Tailwind Klassen nur findet,
		    die im Quelltext stehen. Groß genug für den Beamer, und der Abriss
		    springt ins Auge. */}
		<style>
			.stand {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				line-height: 1.15;
				white-space: nowrap;
				font-variant-numeric: tabular-nums;
				font-size: 0.9375rem;
			}
			@media (min-width: 640px) { .stand { font-size: 1.0625rem; } }
			@media (min-width: 1280px) { .stand { font-size: 1.25rem; } }
			.stand-punkt {
				width: 0.7em;
				height: 0.7em;
				flex: none;
				border-radius: 9999px;
				background: rgba(255, 255, 255, 0.55);
			}
			.stand-lage {
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				font-size: 0.85em;
			}
			.stand-abriss { display: none; font-weight: 700; color: #fecaca; }

			/*
			 * Der Abriss-Balken. Er hängt an einem Merkmal am `<html>`-Element
			 * und nicht an einem Zustand im Skript: So ist er auch dann richtig,
			 * wenn Astro gerade den Seiteninhalt austauscht – das Element
			 * darüber bleibt stehen.
			 */
			.abriss-banner {
				display: none;
				position: fixed;
				top: 0; left: 0; right: 0;
				z-index: 60;
				align-items: center;
				gap: 0.75rem;
				padding: 0.6rem 1rem;
				background: #b91c1c;
				color: #fff;
				font-size: 1rem;
				box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.35);
			}
			html[data-zustellung="unterbrochen"] .abriss-banner { display: flex; }
			.abriss-punkt {
				width: 0.8em; height: 0.8em; flex: none; border-radius: 9999px;
				background: #fecaca; animation: abriss-puls 1.1s ease-in-out infinite;
			}
			.abriss-text { flex: 1; min-width: 0; }
			.abriss-knopf {
				flex: none; padding: 0.25rem 0.9rem; border: 1px solid rgba(255, 255, 255, 0.7);
				background: transparent; color: #fff; font-weight: 700; cursor: pointer;
			}
			.abriss-knopf:hover { background: rgba(255, 255, 255, 0.15); }
			@keyframes abriss-puls { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
			@media (prefers-reduced-motion: reduce) { .abriss-punkt { animation: none; } }
			.stand-uhr { font-weight: 700; }
			.stand-geprueft { font-size: 0.75em; opacity: 0.7; }
			@media (max-width: 639px) { .stand-geprueft { display: none; } }

			#stand-anzeige[data-zustand="verbindet"] .stand-punkt { background: #fbbf24; }
			#stand-anzeige[data-zustand="verbunden"] .stand-punkt {
				background: #4ade80;
				animation: stand-puls 2.4s ease-in-out infinite;
			}
			#stand-anzeige[data-zustand="unterbrochen"] .stand-punkt { background: #ef4444; }
			#stand-anzeige[data-zustand="unterbrochen"] .stand-lage { display: none; }
			#stand-anzeige[data-zustand="unterbrochen"] .stand-abriss { display: inline; }
			#stand-anzeige[data-zustand="unterbrochen"] .stand-geprueft { display: none; }

			@keyframes stand-puls {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.35; }
			}
			@media (prefers-reduced-motion: reduce) {
				#stand-anzeige[data-zustand="verbunden"] .stand-punkt { animation: none; }
			}
		</style>

		<script>
			import { navigate } from "astro:transitions/client";
			import {
				ABFRAGE_MS,
				abstandFuer,
				brauchtNeueLeitung,
				zustandVon,
			} from "../lib/verbindung.ts";
			import { spiele } from "../lib/klang.ts";

			// Beim Wechsel in ein Nachbargebiet soll die Seite stehen bleiben:
			// Astro scrollt bei einer Navigation sonst nach oben. Wer sich durch
			// die Wahllokale klickt, verlöre bei jedem Klick seine Stelle.
			// Gleiche Wahl = gleicher Pfad bis zum Wahl-Slug
			// (/<kreis>/<termin>/<behörde>/<wahl>/…)
			const wahlRumpf = (pfad: string) => pfad.split("/").slice(0, 5).join("/");
			let scrollMerker: number | null = null;
			document.addEventListener("astro:before-preparation", (ereignis) => {
				const ziel = (ereignis as unknown as { to?: URL }).to;
				scrollMerker =
					ziel && wahlRumpf(ziel.pathname) === wahlRumpf(location.pathname)
						? window.scrollY
						: null;
			});
			document.addEventListener("astro:after-swap", () => {
				if (scrollMerker !== null) window.scrollTo({ top: scrollMerker });
				scrollMerker = null;
			});

			// --- Live-Aktualisierung ---
			//
			// Die Seite fragt nicht mehr im Takt nach, sondern hält eine
			// Verbindung offen und bekommt den neuen Stand zugestellt
			// (Server-Sent Events, siehe server/live.ts). Zugestellt wird nur
			// der Versionsstempel des Bereichs, den diese Seite zeigt – die
			// Zahlen holt danach `navigate()`.
			//
			// Warum `navigate()` und nicht `location.reload()`: Die Karte ist
			// eine bestehen bleibende Insel (transition:persist) und baut sich
			// so nicht neu auf, die Seite bleibt stehen, wo sie steht, und
			// Stilblätter und Skripte werden nicht erneut geladen. Trägt das
			// nicht – etwa weil View Transitions abgeschaltet sind –, macht
			// Astro daraus von selbst einen vollen Seitenwechsel; scheitert es
			// ganz, greift `location.reload()`.
			const anzeige = () => document.getElementById("stand-anzeige");
			/**
			 * Was die Zustellung tut, steht in der Konsole.
			 *
			 * Am Wahlabend ist das die einzige Stelle, an der sich von außen
			 * nachsehen lässt, ob eine stehende Seite an fehlenden Zahlen liegt
			 * oder an einer toten Leitung – und ohne diese Zeilen ist beides
			 * nicht zu unterscheiden. Sie sind bewusst wenige: eine je
			 * Zustandswechsel und eine je übernommenem Stand, nicht eine je Puls.
			 */
			const protokoll = (was: string, mehr: unknown = "") =>
				console.info(
					`wahlen ${new Date().toLocaleTimeString("de-DE")} · ${was}`,
					mehr,
				);
			/**
			 * Zustand der Zustellung; steuert Farbe und Text der Anzeige – und
			 * das Merkmal am `<html>`-Element, an dem der Abriss-Balken hängt.
			 *
			 * Warum am Dokument und nicht an der Anzeige: Beim Seitentausch wird
			 * der Inhalt ersetzt, das Dokument nicht. Ein Balken, der am
			 * getauschten Teil hinge, flackerte bei jeder neuen Zahl.
			 */
			let letzterZustand = "";
			const setzeZustand = (zustand: string) => {
				const el = anzeige();
				if (el && el.dataset.live === "1") el.dataset.zustand = zustand;
				const lebt = Boolean(el && el.dataset.live === "1");
				document.documentElement.dataset.zustellung = lebt ? zustand : "";
				if (lebt && zustand !== letzterZustand) {
					protokoll(`Zustellung: ${zustand}`, offeneUrl);
					// Der Ton ist für den Fall, dass gerade niemand hinsieht – am
					// Beamer der wahrscheinlichste. Nur bei echten Wechseln, nicht
					// bei jedem Takt der Uhr.
					if (zustand === "unterbrochen") spiele("abriss");
					else if (zustand === "verbunden" && letzterZustand === "unterbrochen")
						spiele("zurueck");
					letzterZustand = zustand;
				}
			};

			document.addEventListener("click", (e) => {
				const knopf = (e.target as HTMLElement | null)?.closest(
					'[data-abriss="neuladen"]',
				);
				if (knopf) location.reload();
			});
			const uhrzeit = (iso: string) => {
				const d = new Date(iso);
				return Number.isNaN(d.getTime())
					? ""
					: d.toLocaleTimeString("de-DE", { timeZone: "Europe/Berlin", hour: "2-digit", minute: "2-digit" });
			};

			let quelle: EventSource | null = null;
			let offeneUrl = "";
			let letzterKontakt = 0;
			let holtGerade = false;
			let ausstehend = "";
			/** Wann der laufende Verbindungsversuch begonnen hat. */
			let verbindetSeit = 0;
			/** Vergebliche Versuche in Folge – bestimmt den nächsten Abstand. */
			let versuche = 0;
			let neuerVersuch: ReturnType<typeof setTimeout> | undefined;
			/** Wann zuletzt notfalls abgefragt wurde, weil keine Leitung steht. */
			let letzteAbfrage = 0;

			/** Neuen Stand übernehmen – nur, wenn er von dem der Seite abweicht. */
			const uebernehmen = async (version: string) => {
				const el = anzeige();
				if (!el || !version || version === el.dataset.version) return;
				// Im Hintergrund nichts nachladen: ein Dutzend offener Reiter
				// soll den Server am Wahlabend nicht beschäftigen. Beim
				// Zurückkommen wird nachgeholt.
				if (document.visibilityState !== "visible") {
					ausstehend = version;
					return;
				}
				if (holtGerade) return;
				holtGerade = true;
				protokoll("neuer Stand, hole Inhalt nach", version);
				try {
					// **Ohne den Rautenteil.** Astros Router bricht eine Navigation
					// ab, die sich nur im Hash unterscheidet: gleiche Seite plus
					// Ziel-Hash heißt für ihn „hinscrollen", nicht „neu holen"
					// (transitions/router.js). Seit die Leinwand ihre Folie in der
					// Adresse mitführt (`…/dashboard#rat`), traf das jede einzelne
					// Aktualisierung – die Zahlen kamen an, die Seite blieb stehen.
					// Der Hash steht danach sofort wieder da: Das Karussell schreibt
					// ihn beim ersten Umblenden nach dem Tausch zurück.
					await navigate(`${location.pathname}${location.search}`, {
						history: "replace",
					});
				} catch {
					location.reload();
				} finally {
					holtGerade = false;
				}
				// Nach dem Tausch steht der neue Stempel im DOM. Bleibt er stehen
				// (Tausch fehlgeschlagen), versucht es die nächste Meldung erneut.
			};

			const trenne = () => {
				quelle?.close();
				quelle = null;
				offeneUrl = "";
			};

			/**
			 * Der zweite Boden: Steht keine Leitung, wird der Stand abgefragt.
			 *
			 * Damit überlebt die Seite auch das, was SSE nicht überlebt – einen
			 * Proxy, der Streams schluckt, oder einen Server, der minutenlang
			 * weg ist. Sie ist dann langsamer, aber nie falsch.
			 */
			const abfragen = async () => {
				const el = anzeige();
				const url = el?.dataset.liveUrl ?? "";
				if (!el || !url) return;
				const jetzt = Date.now();
				if (jetzt - letzteAbfrage < ABFRAGE_MS) return;
				letzteAbfrage = jetzt;
				try {
					const antwort = await fetch(url.replace("/api/live?", "/api/version.json?"));
					if (!antwort.ok) return;
					const d = (await antwort.json()) as { version?: string };
					if (d.version) await uebernehmen(d.version);
				} catch {
					// Kein Netz – der nächste Takt versucht es wieder.
				}
			};

			/**
			 * Eine Uhr für alles: Sie lässt „verbindet" nach der Nachsicht in
			 * „unterbrochen" kippen, erkennt einen hängenden Socket, der von
			 * sich aus keinen Fehler meldet, und stößt das Wiederverbinden an.
			 */
			const bewerte = () => {
				if (!quelle) return;
				const lage = {
					readyState: quelle.readyState,
					letzterKontakt,
					verbindetSeit,
					jetzt: Date.now(),
				};
				const zustand = zustandVon(lage);
				setzeZustand(zustand);
				if (zustand === "unterbrochen") void abfragen();
				// **Hier hängt der Wahlabend dran.** Der Browser gibt nach einer
				// Fehlerantwort (502 beim Pod-Wechsel) von selbst nicht wieder
				// an; ohne diesen Anstoß stünde die Leinwand still und behauptete
				// „Live". Es gibt deshalb keine Zahl von Versuchen, nach der
				// aufgegeben wird – und auch keine Bedingung an die Sichtbarkeit:
				// Der Beamer-Reiter ist stundenlang im Vordergrund, aber ein
				// Kontrollfenster daneben soll ebenso zurückkommen.
				if (brauchtNeueLeitung(lage)) planeVerbindung();
			};

			/** Nach einem Fehlschlag mit wachsendem Abstand erneut anklopfen. */
			const planeVerbindung = () => {
				if (neuerVersuch) return;
				const abstand = abstandFuer(versuche);
				versuche++;
				protokoll(`neuer Verbindungsversuch in ${abstand} ms`, `Versuch ${versuche}`);
				neuerVersuch = setTimeout(() => {
					neuerVersuch = undefined;
					trenne();
					verbinde();
				}, abstand);
			};

			const verbinde = () => {
				const el = anzeige();
				const url = el?.dataset.liveUrl ?? "";
				if (!el || el.dataset.live !== "1" || !url || !("EventSource" in window)) {
					trenne();
					return;
				}
				if (quelle && offeneUrl === url && quelle.readyState !== 2) {
					// Nach einem Seitentausch kommt die Anzeige frisch aus dem
					// Server-HTML; der Zustand der bestehenden Leitung gilt weiter.
					bewerte();
					return;
				}
				trenne();
				offeneUrl = url;
				verbindetSeit = Date.now();
				setzeZustand(letzterKontakt === 0 ? "verbindet" : zustandVon({
					readyState: 0,
					letzterKontakt,
					verbindetSeit,
					jetzt: Date.now(),
				}));
				const q = new EventSource(url);
				quelle = q;
				const kontakt = (daten?: { geprueft?: string }) => {
					letzterKontakt = Date.now();
					versuche = 0;
					setzeZustand("verbunden");
					const feld = anzeige()?.querySelector(".stand-geprueft");
					if (feld && daten?.geprueft) feld.textContent = `geprüft ${uhrzeit(daten.geprueft)}`;
				};
				q.addEventListener("open", () => kontakt());
				q.addEventListener("puls", (e) => kontakt(JSON.parse((e as MessageEvent).data)));
				q.addEventListener("stand", (e) => {
					const d = JSON.parse((e as MessageEvent).data) as { version: string; geprueft?: string };
					kontakt(d);
					uebernehmen(d.version);
				});
				// EventSource verbindet nach einem gewöhnlichen Abriss von selbst
				// neu. Nach einer Fehlerantwort nicht – dann übernimmt `bewerte`.
				q.addEventListener("error", bewerte);
			};

			setInterval(bewerte, 1_000);

			// Astro räumt beim Seitentausch alle Attribute vom `<html>`-Element ab
			// (swapRootAttributes). Der Abriss-Balken hängt an einem davon – ohne
			// dieses Zurückschreiben verschwände er ausgerechnet dann, wenn die
			// Seite gerade nachgeladen hat, und käme erst beim nächsten
			// Zustandswechsel wieder.
			document.addEventListener("astro:after-swap", () => {
				const el = anzeige();
				if (el?.dataset.live === "1" && letzterZustand)
					document.documentElement.dataset.zustellung = letzterZustand;
			});

			document.addEventListener("visibilitychange", () => {
				if (document.visibilityState !== "visible") return;
				// Zurück im Vordergrund: Erst nachsehen, ob die Leitung noch
				// steht – ein Rechner aus dem Ruhezustand bringt einen toten
				// Socket mit, den niemand für tot hält.
				bewerte();
				if (ausstehend) {
					const version = ausstehend;
					ausstehend = "";
					uebernehmen(version);
				}
			});

			// Läuft beim ersten Aufbau und nach jedem Seitentausch: Der Bereich –
			// und damit die Adresse der Zustellung – ändert sich mit der Seite.
			document.addEventListener("astro:page-load", verbinde);
		</script>
	</body>
</html>
