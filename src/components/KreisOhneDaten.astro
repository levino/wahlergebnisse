---
import type { Kreis } from "../data/kreise.ts";

interface Props {
	kreis: Kreis;
}
const { kreis } = Astro.props;
const quellen = kreis.quellen ?? [];
---

<section class="bg-base-100 p-6 max-w-3xl">
	<h1 class="text-2xl font-bold">{kreis.name}</h1>

	{quellen.length > 0 ? (
		<>
			<p class="mt-3">
				Die Ergebnisse für diesen Kreis liegen hier nicht vor – wohl aber
				bei der Wahlleitung selbst:
			</p>
			<ul class="mt-4 flex flex-col gap-2">
				{quellen.map((q) => (
					<li>
						<a
							href={q.url}
							rel="noopener external"
							class="link link-primary font-semibold"
						>{q.titel}</a>
						<span class="block text-sm opacity-70 break-all">{q.url}</span>
					</li>
				))}
			</ul>
			<p class="mt-4 text-sm opacity-80">
				Das sind die amtlichen Seiten der zuständigen Wahlleitung. Sie
				öffnen sich außerhalb dieser Anwendung; für ihre Inhalte ist die
				jeweilige Behörde verantwortlich.
			</p>
		</>
	) : (
		<p class="mt-3">
			Für diesen Kreis liegen hier keine Ergebnisse vor. Die amtlichen
			Ergebnisse gibt die zuständige Wahlleitung bekannt.
		</p>
	)}

	{kreis.hinweis && (
		<p class="mt-4 opacity-80">
			<span class="font-semibold">Warum nicht hier:</span> {kreis.hinweis}
		</p>
	)}

	<p class="mt-4">
		<a href="/" class="btn btn-sm btn-neutral">Anderen Kreis wählen</a>
	</p>
</section>
