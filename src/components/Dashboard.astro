---
import { type DashboardModell, parteienZurAuswahl } from "../lib/dashboard.ts";
import { demoAn } from "../lib/demo.ts";
import { STIMME_HINWEIS } from "../lib/stimme.ts";
import DashboardFolie from "./DashboardFolie.astro";

interface Props {
	m: DashboardModell;
}
const { m } = Astro.props;
const parteien = parteienZurAuswahl(m.folien);
const demo = demoAn();
---

<section
	class="db-buehne"
	data-dashboard
	data-takt={m.takt}
	data-topic={m.topic}
	data-termin={m.termin.id}
	aria-label={`Wahlabend ${m.behoerde.kurz}: ${m.folien.length} Ansichten im Wechsel`}
>
	<div class="db-takt" aria-hidden="true"><div class="db-takt-fuellung"></div></div>

	<div class="db-folien">
		{m.folien.map((f, i) => (
			<DashboardFolie folie={f} aktiv={i === 0} nummer={i + 1} gesamt={m.folien.length} />
		))}
	</div>

	<div class="db-leiste">
		<div class="db-knoepfe">
			<button type="button" class="db-knopf" data-db="zurueck" aria-label="Vorherige Ansicht">‹</button>
			<button type="button" class="db-knopf db-knopf--breit" data-db="pause" aria-pressed="false">
				<span class="db-pause-an">Pause</span>
				<span class="db-pause-aus">Weiter</span>
			</button>
			<button type="button" class="db-knopf" data-db="vor" aria-label="Nächste Ansicht">›</button>
		</div>

		<ol class="db-punkte" data-db="punkte">
			{m.folien.map((f, i) => (
				<li>
					<a class:list={["db-punkt-knopf", i === 0 && "db-punkt-knopf--aktiv"]} href={`#${f.marke}`} data-ziel={i} aria-label={`${f.art === "ueberblick" ? "Überblick" : `${f.wahl} ${f.ort}`} zeigen`}></a>
				</li>
			))}
		</ol>

		<div class="db-knoepfe">
			<select class="db-partei" data-db="partei" aria-label="Meine Partei">
				<option value="">Meine Partei …</option>
				{parteien.map((p) => (
					<option value={p.key} data-kurz={p.kurz} data-farbe={p.farbe}>{p.kurz}</option>
				))}
			</select>
			<a class="db-knopf db-knopf--still" data-db="seite" href={m.folien.find((f) => f.art === "wahl")?.href ?? "."}>Zur Wahlseite</a>
			<button type="button" class="db-knopf db-knopf--ton" data-db="ton" aria-pressed="true" title="Ton bei neuen Zahlen">
				<span class="db-ton-an" aria-hidden="true">🔔</span>
				<span class="db-ton-aus" aria-hidden="true">🔕</span>
				<span class="db-nur-vorlesen">Ton</span>
			</button>
			<button type="button" class="db-knopf" data-db="probe" title="Probesatz sprechen">Probe</button>
			<button type="button" class="db-knopf" data-db="vollbild">Vollbild</button>
		</div>
	</div>

	<div class="db-hinweise">
		{demo && <p class="db-ansagespur" data-ansagespur hidden></p>}
		<p class="db-stimmhinweis" data-stimmhinweis hidden></p>
	</div>

	<div class="db-meldungen" data-meldungen transition:persist="db-meldungen" aria-live="polite" aria-atomic="false"></div>

	<div class="db-tonsperre" data-tonsperre role="status">
		<p class="db-tonsperre-wort">Einmal klicken bitte</p>
	</div>

	{m.hinweise.length > 0 && (
		<ul class="db-fehlt" data-fehlt>
			{m.hinweise.map((h) => <li>{h}</li>)}
		</ul>
	)}

	<p class="db-hilfe">
		<span data-stimmnotiz hidden>{STIMME_HINWEIS} · </span>Leertaste: Pause · Pfeiltasten: blättern · F: Vollbild · Esc: zurück · Adresse merkt sich die Folie
	</p>
</section>

<style is:global>
	.db-buehne {
		container-type: size;
		position: relative;
		display: flex;
		flex-direction: column;
		height: min(78vh, 56rem);
		min-height: 30rem;
		background: #222c38;
		color: #fff;
		overflow: hidden;
	}

	.db-takt { height: 0.5cqmin; min-height: 3px; background: rgba(255, 255, 255, 0.14); flex: none; }
	.db-takt-fuellung { height: 100%; width: 0; background: #52b7c1; }
	.db-buehne[data-pausiert="1"] .db-takt-fuellung { background: #ffa600; }

	.db-folien { flex: 1; min-height: 0; display: flex; overflow: hidden; }

	.db-folie { display: none; flex: 1; min-width: 0; flex-direction: column; gap: 1.6cqmin; padding: 3cqmin 3.5cqmin 1.6cqmin; }
	.db-folie--aktiv { display: flex; }

	.db-kopf { flex: none; }
	.db-wahl {
		display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5em;
		font-size: clamp(0.75rem, 3.1cqmin, 2.1rem);
		text-transform: uppercase; letter-spacing: 0.09em; font-weight: 700; color: #7fd3db;
	}
	.db-ort {
		font-size: clamp(1.6rem, 9.5cqmin, 8rem);
		font-weight: 800; line-height: 0.95; letter-spacing: -0.015em;
		hyphens: manual; overflow-wrap: break-word;
	}
	a.db-titel { color: inherit; text-decoration: none; display: block; }
	a.db-titel:hover .db-ort { text-decoration: underline; text-decoration-thickness: 0.08em; text-underline-offset: 0.08em; }

	.db-marke {
		font-size: 0.72em; letter-spacing: 0.05em; padding: 0.15em 0.6em;
		border: 1px solid currentColor; color: #cfe6ea; white-space: nowrap;
	}
	.db-marke--warn { color: #ffc857; }

	/* Zwischenstand, Hochrechnung, Endergebnis – die Farbe sagt es vor der Schrift. */
	.db-band {
		flex: none; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6em;
		border-left: 1cqmin solid #94a3b8; padding: 0.5cqmin 1.4cqmin;
		background: rgba(255, 255, 255, 0.07);
		font-size: clamp(0.8rem, 3.2cqmin, 2.3rem);
	}
	.db-band strong { text-transform: uppercase; letter-spacing: 0.04em; }
	.db-band--endergebnis { border-color: #4ade80; }
	.db-band--hochrechnung { border-color: #ffa600; }
	.db-band--zwischenstand, .db-band--neutral { border-color: #94a3b8; }
	.db-band--neutral .db-stand { margin-left: 0; font-size: 1em; opacity: 1; white-space: normal; }
	.db-unsicher { border: 1px solid rgba(255, 200, 87, 0.7); color: #ffc857; padding: 0 0.5em; font-size: 0.8em; text-transform: uppercase; }
	.db-stand { margin-left: auto; display: flex; align-items: center; gap: 0.6em; font-size: 0.76em; opacity: 0.85; white-space: nowrap; }
	.db-stand-balken { width: 8em; }

	.db-inhalt { flex: 1; min-height: 0; display: flex; gap: 3cqmin; overflow: hidden; }
	.db-balken { --balken: 6; flex: 4 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 1.4cqmin; font-size: max(0.85rem, min(4.1cqmin, calc(46cqh / (var(--balken) * 2.5)))); }
	.db-seite { --grund: max(0.6rem, min(2.6cqmin, calc(44cqh / var(--posten, 12)))); flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 1.1em; font-size: var(--grund); }
	@container (max-aspect-ratio: 4 / 5) {
		.db-inhalt { flex-direction: column; gap: 2cqmin; }
	}

	.db-balken-zeile { display: flex; flex-direction: column; gap: 0.4cqmin; }
	.db-balken-kopf { display: flex; align-items: baseline; justify-content: space-between; gap: 1em; }
	.db-name { font-size: 1em; font-weight: 700; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.db-zusatz { font-weight: 400; opacity: 0.7; margin-left: 0.5em; font-size: 0.75em; }
	.db-werte { display: flex; align-items: baseline; gap: 0.6em; white-space: nowrap; font-variant-numeric: tabular-nums; }
	.db-prozent { font-size: 1.12em; font-weight: 800; }
	.db-diff { font-size: 0.66em; opacity: 0.85; }
	.db-diff--auf { color: #86efac; }
	.db-diff--ab { color: #fca5a5; }
	.db-schiene { display: block; height: 0.64em; background: rgba(255, 255, 255, 0.13); }
	.db-fuellung { display: block; height: 100%; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); }
	.db-leer, .db-weitere { font-size: 0.78em; opacity: 0.75; }

	.db-personen { gap: 0.5em; }
	.db-personen-kopf { font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.08em; color: #7fd3db; }
	.db-person { display: flex; align-items: baseline; gap: 0.6em; border-bottom: 1px solid rgba(255, 255, 255, 0.12); padding-bottom: 0.25em; }
	.db-person-platz { min-width: 1.4em; text-align: right; font-variant-numeric: tabular-nums; opacity: 0.55; font-size: 0.8em; }
	.db-person-name { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.db-person-partei { opacity: 0.7; font-size: 0.75em; white-space: nowrap; }
	.db-person-wert { margin-left: auto; font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }

	.db-listen { justify-content: flex-start; gap: 0.8em; }
	.db-listen-raster { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9em 2em; }
	@container (max-aspect-ratio: 4 / 5) {
		.db-listen-raster { grid-template-columns: minmax(0, 1fr); }
	}
	.db-liste-partei { min-width: 0; }
	.db-liste-kopf { display: flex; align-items: center; gap: 0.45em; font-size: 0.9em; text-transform: uppercase; letter-spacing: 0.06em; color: #cfe6ea; border-bottom: 1px solid rgba(255, 255, 255, 0.18); padding-bottom: 0.2em; }
	.db-liste-namen { display: flex; flex-direction: column; gap: 0.15em; margin-top: 0.25em; }
	.db-liste-namen .db-person { border-bottom: 0; padding-bottom: 0; }

	.db-kennzahl { display: flex; flex-direction: column; gap: 0.15em; }
	.db-kennzahl-wert { font-size: 2.7em; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
	.db-kennzahl-label { font-size: 1.1em; text-transform: uppercase; letter-spacing: 0.08em; color: #7fd3db; }
	.db-kennzahl-fuss { font-size: 0.92em; opacity: 0.75; }

	.db-mini { display: block; height: clamp(0.3rem, 1.4cqmin, 1rem); background: rgba(255, 255, 255, 0.16); }
	.db-mini--gross { height: 0.75em; margin-top: 0.2em; }
	.db-mini-fuellung { display: block; height: 100%; background: #52b7c1; transition: width 600ms ease-out; }
	.db-mini-fuellung--fertig { background: #4ade80; }

	.db-sitze { display: flex; flex-direction: column; gap: 0.4em; }
	.db-sitze-kopf { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5em; font-size: 1.1em; text-transform: uppercase; letter-spacing: 0.08em; color: #7fd3db; }
	.db-sitze-kopf strong { font-size: 1.5em; color: #fff; letter-spacing: 0; }
	.db-sitzband { position: relative; display: flex; height: 1.15em; background: rgba(255, 255, 255, 0.13); }
	.db-sitzteil { display: block; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3); }
	/* Die Mehrheitslinie: die einzige Marke, nach der am Wahlabend gefragt wird. */
	.db-mehrheit { position: absolute; top: -0.2em; bottom: -0.2em; left: 50%; width: 2px; background: #fff; }
	.db-sitzliste { display: flex; flex-wrap: wrap; gap: 0.3em 1em; font-size: 1.05em; }
	.db-sitzliste li { display: inline-flex; align-items: center; gap: 0.35em; }
	.db-punkt { display: inline-block; width: 0.7em; height: 0.7em; border-radius: 9999px; flex: none; box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.45); }
	.db-zahl { font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; }

	.db-liste { --zeilen: var(--zeilen-schmal, 10); flex: 0 1 auto; margin-block: auto; min-height: 0; overflow: hidden; font-size: clamp(0.5rem, min(2.6cqmin, calc(54cqh / (var(--zeilen) * 4.4))), 1.7rem); }
	@container (min-aspect-ratio: 1 / 1) {
		.db-liste--breit { --zeilen: var(--zeilen-breit, 10); columns: 2; column-gap: 4cqmin; }
	}
	.db-liste li { break-inside: avoid; }
	a.db-zeile { color: inherit; text-decoration: none; }
	a.db-zeile:hover { background: rgba(255, 255, 255, 0.08); }
	.db-zeile { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: 1.2cqmin; padding: 0.45em 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
	.db-zeile-name { min-width: 0; display: flex; flex-direction: column; overflow: hidden; }
	.db-zeile-name strong { font-size: 1.25em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.db-zeile-wahl { opacity: 0.65; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.db-zeile-spitze { display: flex; align-items: center; gap: 0.5em; min-width: 0; }
	.db-zeile-spitze .db-zahl { margin-left: auto; }
	.db-zeile-partei { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.db-zeile-leer { opacity: 0.55; }
	.db-zeile-stand { display: flex; align-items: center; gap: 0.6em; }
	.db-zeile-stand .db-mini { flex: 1; }
	@container (max-aspect-ratio: 4 / 5) {
		.db-zeile { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
		.db-zeile-stand { grid-column: 1 / -1; }
	}

	.db-fuss { flex: none; display: flex; align-items: baseline; justify-content: space-between; gap: 1em; font-size: clamp(0.6rem, 2.2cqmin, 1.4rem); opacity: 0.6; }
	.db-demo { color: #1b191d; background: #ffa600; padding: 0.1em 0.6em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 1; }
	.db-fuss-links { flex: 1; }
	.db-fuss-rechts { font-variant-numeric: tabular-nums; }

	.db-meldungen {
		position: absolute; right: 2cqmin; bottom: 5.5rem; z-index: 5;
		display: flex; flex-direction: column; align-items: flex-end; gap: 0.6cqmin;
		max-width: min(48cqw, 34rem); pointer-events: none;
	}
	.db-meldung {
		display: flex; align-items: baseline; gap: 0.7em;
		width: 100%; text-align: left;
		padding: 0.55em 1em;
		background: rgba(15, 21, 28, 0.92);
		border: 0; border-left: 0.8cqmin solid #52b7c1;
		box-shadow: 0 0.4rem 1.4rem rgba(0, 0, 0, 0.45);
		color: inherit; font-family: inherit;
		font-size: clamp(0.8rem, 2.5cqmin, 1.6rem);
		cursor: pointer;
		animation: db-ein 320ms ease-out;
	}
	.db-meldung--geht { animation: db-aus 420ms ease-in forwards; }
	.db-meldung strong { font-weight: 800; }
	.db-meldung-wahl { opacity: 0.7; font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.06em; }
	/* Fertig ausgezählt ist der eine Moment, auf den im Saal gewartet wird. */
	.db-meldung--fertig { border-left-color: #4ade80; background: rgba(22, 42, 28, 0.94); }
	.db-meldung--hochrechnung { border-left-color: #ffa600; }
	.db-meldung--endergebnis { border-left-color: #4ade80; }
	.db-meldung--spitze { border-left-color: #ffc857; }
	.db-meldung--jubel, .db-meldung--abstieg {
		font-size: clamp(0.95rem, 3.2cqmin, 2.1rem);
		background: rgba(15, 21, 28, 0.96);
	}
	.db-meldung--jubel {
		border-left-color: var(--partei-akzent, #ffc857);
		animation: db-ein 320ms ease-out, db-jubel 620ms ease-out 320ms;
	}
	.db-meldung--abstieg { border-left-color: #fca5a5; }
	@keyframes db-jubel {
		0%, 100% { transform: none; }
		35% { transform: scale(1.07); }
		70% { transform: scale(0.99); }
	}
	@keyframes db-ein {
		from { opacity: 0; transform: translateX(18%); }
		to { opacity: 1; transform: none; }
	}
	@keyframes db-aus {
		from { opacity: 1; transform: none; }
		to { opacity: 0; transform: translateY(-25%); }
	}
	@media (prefers-reduced-motion: reduce) {
		.db-meldung, .db-meldung--geht, .db-meldung--jubel { animation: none; }
	}

	.db-leiste { flex: none; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.6rem 1rem; background: rgba(0, 0, 0, 0.28); }
	.db-knoepfe { display: flex; align-items: center; gap: 0.4rem; }
	.db-knopf { min-width: 2.5rem; padding: 0.35rem 0.85rem; border: 1px solid rgba(255, 255, 255, 0.35); background: transparent; color: #fff; font-size: 1rem; font-weight: 700; line-height: 1.4; cursor: pointer; text-decoration: none; }
	.db-knopf:hover { background: rgba(255, 255, 255, 0.14); }
	.db-knopf--breit { min-width: 6rem; }
	.db-knopf--still { font-weight: 400; border-color: rgba(255, 255, 255, 0.2); }
	.db-pause-aus { display: none; }
	.db-knopf--ton { min-width: 3rem; font-size: 1.1rem; line-height: 1; }
	.db-ton-aus { display: none; }
	.db-buehne[data-ton="aus"] .db-ton-an { display: none; }
	.db-buehne[data-ton="aus"] .db-ton-aus { display: inline; }
	/* Für Schirmleser: Das Glockenzeichen allein sagt nichts. */
	.db-nur-vorlesen {
		position: absolute; width: 1px; height: 1px; overflow: hidden;
		clip-path: inset(50%); white-space: nowrap;
	}
	.db-buehne[data-pausiert="1"] .db-pause-an { display: none; }
	.db-buehne[data-pausiert="1"] .db-pause-aus { display: inline; }

	.db-partei {
		max-width: 11rem; padding: 0.35rem 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.35); background: transparent;
		color: inherit; font-size: 1rem; font-weight: 700; line-height: 1.4; cursor: pointer;
	}
	.db-partei option { background: #fff; color: #1b191d; }

	.db-punkte { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
	.db-punkt-knopf { display: block; width: 0.7rem; height: 0.7rem; border: 0; border-radius: 9999px; background: rgba(255, 255, 255, 0.3); cursor: pointer; padding: 0; }
	.db-punkt-knopf--aktiv { background: #52b7c1; transform: scale(1.35); }

	.db-hilfe { flex: none; padding: 0.35rem 1rem 0.6rem; background: rgba(0, 0, 0, 0.28); font-size: 0.8rem; opacity: 0.6; }

	/* Bleibt auch im Vollbild stehen: Fehlendes soll im Saal zu sehen sein. */
	.db-fehlt { flex: none; padding: 0.3rem 1rem; background: rgba(0, 0, 0, 0.42); font-size: 0.78rem; opacity: 0.78; }
	.db-fehlt li { list-style: none; }

	/* Solange der Browser den Ton sperrt, muss das quer über die Leinwand. */
	.db-tonsperre {
		position: absolute; inset: 0; z-index: 40;
		display: flex; align-items: center; justify-content: center;
		padding: 4cqmin;
		background: rgba(8, 11, 15, 0.58);
		pointer-events: none;
	}
	.db-tonsperre-wort {
		max-width: 100%;
		padding: 0.28em 0.6em;
		background: #d81717;
		color: #fff;
		border: 0.05em solid rgba(255, 255, 255, 0.85);
		box-shadow: 0 1cqmin 4cqmin rgba(0, 0, 0, 0.55);
		font-size: clamp(1.5rem, 11cqmin, 9rem);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: -0.01em;
		text-align: center;
		text-wrap: balance;
	}

	.db-hinweise { position: absolute; left: 0; right: 0; bottom: 0; }
	.db-stimmhinweis, .db-ansagespur {
		padding: 0.35rem 1rem;
		background: #12171d;
		font-size: 0.8rem;
	}
	.db-stimmhinweis { color: #ffc857; padding-bottom: 0.6rem; }
	.db-ansagespur { color: #8fa3b8; }
	.db-ansagespur[data-fehler] { color: #ff8080; }
	.db-buehne:has(.db-hinweise > :not([hidden])) .db-hilfe { visibility: hidden; }

	html[data-partei] .db-buehne { background: var(--partei-grund); }
	html[data-partei] .db-takt-fuellung { background: var(--partei-akzent); }
	html[data-partei] .db-wahl,
	html[data-partei] .db-personen-kopf,
	html[data-partei] .db-kennzahl-label,
	html[data-partei] .db-sitze-kopf { color: var(--partei-akzent); }
	html[data-partei] .db-punkt-knopf--aktiv { background: var(--partei-akzent); }
	html[data-partei] .db-leiste,
	html[data-partei] .db-hilfe { background: var(--partei-farbe); color: var(--partei-schrift); }
	html[data-partei] .db-leiste .db-knopf,
	html[data-partei] .db-leiste .db-partei { border-color: currentColor; color: inherit; }
	html[data-partei] .db-leiste .db-knopf:hover { background: rgba(127, 127, 127, 0.28); }

	html[data-vollbild="dashboard"] .nur-fenster { display: none !important; }
	html[data-vollbild="dashboard"] body { background: #222c38; height: 100vh; height: 100dvh; overflow: hidden; }
	html[data-partei][data-vollbild="dashboard"] body { background: var(--partei-grund); }
	html[data-vollbild="dashboard"] main { max-width: none; padding: 0; flex: 1; min-height: 0; display: flex; }
	html[data-vollbild="dashboard"] .db-buehne { flex: 1; min-height: 0; height: auto; }
	html[data-vollbild="dashboard"] .db-hilfe { display: none; }

	@media (prefers-reduced-motion: reduce) {
		.db-takt-fuellung, .db-mini-fuellung { transition: none; }
	}
</style>

<script>
	/** Was ein Folienwechsel mit der Verlaufsliste des Browsers macht. */
	type Historie = "keine" | "ersetzen" | "eintragen";

	import {
		MELDUNGEN_HOECHSTENS,
		klangArt,
		satz,
	} from "../lib/meldungen.ts";
	import {
		beiFreigabe,
		gibTonFrei,
		horcheAufGeste,
		setzeTon,
		spiele,
		tonAn,
		tonFrei,
	} from "../lib/klang.ts";
	import {
		type MeinePartei,
		meinePartei,
		setzeMeinePartei,
		themaAnwenden,
	} from "../lib/partei.ts";
	import {
		ansageAn,
		merkeAufnahme,
		reiheBeitragEin,
		sprichProbe,
		verstumme,
		wennAnsageSpur,
	} from "../lib/stimme.ts";
	import {
		type BeitragAnsicht,
		type BeitragOrt,
		beitragZeiger,
	} from "../lib/beitrag-abruf.ts";

	let stelle = 0;
	let pausiert = false;
	let begonnen = Date.now();
	let uhr: ReturnType<typeof setInterval> | undefined;
	let gebunden = false;
	type Wachsperre = { release: () => Promise<void> };
	let wachhalter: Wachsperre | null = null;

	const zeiger = beitragZeiger();

	const buehne = (): HTMLElement | null =>
		document.querySelector<HTMLElement>("[data-dashboard]");
	const folien = (b: HTMLElement): HTMLElement[] =>
		Array.from(b.querySelectorAll<HTMLElement>(".db-folie"));

	const MELDUNG_MS = 18_000;
	const MELDUNG_FERTIG_MS = 30_000;
	const MELDUNGEN_SICHTBAR = 5;

	const beitragOrt = (b: HTMLElement): BeitragOrt => ({
		termin: b.dataset.termin ?? "",
		topic: b.dataset.topic ?? "",
		...(meinePartei()?.key ? { partei: meinePartei()?.key } : {}),
	});

	/**
	 * Ein Ping sagt nur, dass es etwas Neues gibt. Geholt wird es hier, und
	 * zwar alles, was seit der zuletzt gesehenen Kennung dazugekommen ist.
	 */
	const holeBeitraege = async (bis: number): Promise<void> => {
		const b = buehne();
		if (!b) return;
		const schub = await zeiger.hole(beitragOrt(b), bis);
		if (!schub || schub.beitraege.length === 0) return;
		merkeSpur(
			"paket",
			schub.uebersprungen
				? `Pakete bis ${schub.kennung}, ältere übersprungen`
				: `Paket ${schub.kennung}`,
			false,
		);
		// Die Einblender aller neuen Pakete, Ton und Ansage nur vom jüngsten:
		// zwanzig Ansagen hintereinander hört im Saal niemand.
		for (const [i, p] of schub.beitraege.entries())
			zeigeBeitrag(p, i === schub.beitraege.length - 1);
	};

	const zeigeBeitrag = (p: BeitragAnsicht, juengstes: boolean): void => {
		const b = buehne();
		const kasten = b?.querySelector<HTMLElement>("[data-meldungen]");
		if (!b || !kasten || p.toasts.length === 0) return;
		const zeigen = p.toasts.slice(0, MELDUNGEN_HOECHSTENS);
		const rest = p.toasts.length - zeigen.length;
		const zeige = () => {
			for (const t of zeigen) haenge(kasten, t.art, satz(t));
			if (rest > 0)
				haenge(kasten, "stand", `und ${rest} weitere Meldung${rest === 1 ? "" : "en"}`);
		};
		// Ältere Pakete eines Nachzugs tragen nur ihre Zahlen nach: kein Ton,
		// keine Stimme, sonst redete die Leinwand den Rückstand ab.
		if (!juengstes) {
			zeige();
			return;
		}
		const art = zeigen[0].art;
		merkeAufnahme(p.aufnahme ?? "");
		// Einblender, Ton und Stimme gehören in denselben Augenblick. Die
		// Schlange hält sie zusammen und lässt keine zwei übereinander sprechen.
		reiheBeitragEin({
			url: p.aufnahme,
			dringend: art === "fertig" || art === "jubel" || art === "abstieg",
			zeige,
			ton: () => spiele(klangArt(zeigen)),
		});
	};

	const spur = { paket: "", stimme: "", fehler: false };

	const merkeSpur = (
		teil: "paket" | "stimme",
		text: string,
		fehler: boolean,
	): void => {
		spur[teil] = text;
		spur.fehler = fehler || (teil === "paket" ? false : spur.fehler);
		if (fehler) console.warn(`Ansage: ${text}`);
		zeigeAnsagespur();
	};

	const zeigeAnsagespur = (): void => {
		const p = document.querySelector<HTMLElement>("[data-ansagespur]");
		if (!p) return;
		const teile = [spur.paket, spur.stimme].filter(Boolean);
		if (teile.length === 0) return;
		p.textContent = `Ansage: ${teile.join(" · ")}`;
		if (spur.fehler) p.dataset.fehler = "1";
		else delete p.dataset.fehler;
		p.hidden = false;
	};

	const haenge = (kasten: HTMLElement, art: string, text: string): void => {
		const el = document.createElement("button");
		el.type = "button";
		el.className = `db-meldung db-meldung--${art}`;
		el.title = "Wegklicken";
		const t = document.createElement("strong");
		t.textContent = text;
		el.append(t);
		const weg = () => {
			el.classList.add("db-meldung--geht");
			setTimeout(() => el.remove(), 420);
		};
		el.addEventListener("click", (e) => {
			e.stopPropagation();
			weg();
		});
		kasten.append(el);
		for (const alt of [...kasten.children].slice(0, -MELDUNGEN_SICHTBAR))
			alt.remove();
		const dauer =
			art === "fertig" || art === "jubel" ? MELDUNG_FERTIG_MS : MELDUNG_MS;
		setTimeout(weg, dauer);
	};

	/** Sekunden je Folie, wie sie der Server aus `?takt=` errechnet hat. */
	const takt = (b: HTMLElement): number => Number(b.dataset.takt) || 18;

	const merkeAdresse = (marke: string | undefined, art: Historie): void => {
		if (!marke || art === "keine") return;
		const ziel = `${location.pathname}${location.search}#${marke}`;
		if (`${location.pathname}${location.search}${location.hash}` === ziel) return;
		const zustand = history.state as { index?: number } | null;
		if (art === "eintragen")
			history.pushState(
				zustand ? { ...zustand, index: (zustand.index ?? 0) + 1 } : null,
				"",
				ziel,
			);
		else history.replaceState(zustand, "", ziel);
	};

	const stelleAusAdresse = (b: HTMLElement): number => {
		const marke = decodeURIComponent(location.hash.replace(/^#/, ""));
		if (!marke) return -1;
		return folien(b).findIndex((f) => f.dataset.marke === marke);
	};

	const zeige = (
		i: number,
		neuStarten = true,
		historie: Historie = "ersetzen",
	): void => {
		const b = buehne();
		if (!b) return;
		const alle = folien(b);
		if (alle.length === 0) return;
		stelle = ((i % alle.length) + alle.length) % alle.length;
		merkeAdresse(alle[stelle]?.dataset.marke, historie);
		alle.forEach((f, n) => {
			const aktiv = n === stelle;
			f.classList.toggle("db-folie--aktiv", aktiv);
			if (aktiv) f.removeAttribute("aria-hidden");
			else f.setAttribute("aria-hidden", "true");
		});
		for (const p of b.querySelectorAll<HTMLElement>(".db-punkt-knopf"))
			p.classList.toggle(
				"db-punkt-knopf--aktiv",
				Number(p.dataset.ziel) === stelle,
			);
		const seite = b.querySelector<HTMLAnchorElement>('[data-db="seite"]');
		const ziel = alle[stelle]?.dataset.href;
		if (seite) {
			seite.hidden = !ziel;
			if (ziel) seite.href = ziel;
		}
		if (neuStarten) begonnen = Date.now();
		male();
	};

	/** Den Fortschrittsbalken der Standzeit nachziehen. */
	const male = (): void => {
		const b = buehne();
		if (!b) return;
		const balken = b.querySelector<HTMLElement>(".db-takt-fuellung");
		if (!balken) return;
		const dauer = takt(b) * 1000;
		const anteil = pausiert
			? Number(balken.style.width.replace("%", "")) || 0
			: Math.min(100, ((Date.now() - begonnen) / dauer) * 100);
		balken.style.width = `${anteil}%`;
	};

	const schlag = (): void => {
		const b = buehne();
		if (!b) return;
		if (pausiert || document.visibilityState !== "visible") return;
		if (Date.now() - begonnen >= takt(b) * 1000) zeige(stelle + 1);
		else male();
	};

	const zeigePartei = (): void => {
		const feld = buehne()?.querySelector<HTMLSelectElement>(
			'[data-db="partei"]',
		);
		if (!feld) return;
		const p = meinePartei();
		feld.value = p && [...feld.options].some((o) => o.value === p.key) ? p.key : "";
	};

	/** Was in der Auswahl steht, als gespeicherte Wahl. */
	const ausAuswahl = (feld: HTMLSelectElement): MeinePartei | undefined => {
		const gewaehlt = feld.selectedOptions[0];
		if (!gewaehlt?.value) return undefined;
		return {
			key: gewaehlt.value,
			kurz: gewaehlt.dataset.kurz ?? gewaehlt.textContent?.trim() ?? "",
			farbe: gewaehlt.dataset.farbe ?? "",
		};
	};

	const zeigeStimmhinweis = (): void => {
		const notiz = document.querySelector<HTMLElement>("[data-stimmnotiz]");
		if (notiz) notiz.hidden = !ansageAn();
	};

	/** Der Hinweis steht, bis der Ton frei ist – dann ist er fort, nicht nur unsichtbar. */
	const zeigeTonsperre = (): void => {
		if (!tonFrei()) return;
		for (const el of document.querySelectorAll("[data-tonsperre]")) el.remove();
	};

	/** Den Tonschalter auf den gespeicherten Wunsch stellen. */
	const zeigeTon = (): void => {
		const b = buehne();
		if (!b) return;
		const an = tonAn();
		b.dataset.ton = an ? "an" : "aus";
		b.querySelector('[data-db="ton"]')?.setAttribute(
			"aria-pressed",
			an ? "true" : "false",
		);
	};

	const setzePause = (wert: boolean): void => {
		pausiert = wert;
		const b = buehne();
		if (!b) return;
		b.dataset.pausiert = wert ? "1" : "0";
		b.querySelector('[data-db="pause"]')?.setAttribute(
			"aria-pressed",
			wert ? "true" : "false",
		);
		if (!wert) begonnen = Date.now();
	};

	const wachhalten = async (an: boolean): Promise<void> => {
		try {
			if (!an) {
				await wachhalter?.release();
				wachhalter = null;
				return;
			}
			const sperren = (
				navigator as unknown as {
					wakeLock?: { request: (art: string) => Promise<Wachsperre> };
				}
			).wakeLock;
			if (wachhalter || !sperren) return;
			wachhalter = await sperren.request("screen");
		} catch {
			wachhalter = null;
		}
	};

	const vollbild = (): void => {
		if (document.fullscreenElement) void document.exitFullscreen();
		else void document.documentElement.requestFullscreen().catch(() => {});
	};

	const binde = (): void => {
		if (gebunden) return;
		gebunden = true;

		horcheAufGeste();
		beiFreigabe(zeigeTonsperre);
		wennAnsageSpur((h) => {
			const gespielt = h.grund === "gespielt";
			merkeSpur(
				"stimme",
				gespielt ? "gespielt" : `stumm: ${h.meldung ?? h.grund}`,
				!gespielt,
			);
		});
		document.addEventListener("wahlen:beitrag", (e) => {
			const kennung = (e as CustomEvent<{ kennung: number }>).detail?.kennung;
			if (kennung !== undefined) void holeBeitraege(kennung);
		});

		document.addEventListener("click", (e) => {
			const ziel = e.target as HTMLElement | null;
			const sprung = ziel?.closest<HTMLElement>("[data-ziel]");
			if (sprung) {
				e.preventDefault();
				zeige(Number(sprung.dataset.ziel), true, "eintragen");
				setzePause(true);
				return;
			}
			const knopf = ziel?.closest<HTMLElement>("[data-db]");
			if (!knopf) return;
			gibTonFrei();
			const was = knopf.dataset.db;
			if (was === "ton") {
				const an = !tonAn();
				setzeTon(an);
				zeigeTon();
				// Die Glocke ist der Griff, mit dem im Saal jemand das Wort
				// ergreift: Ausschalten macht sofort still, auch mitten im Satz.
				zeigeStimmhinweis();
				if (an) spiele("neu");
				else verstumme();
			}
			if (was === "probe") sprichProbe();
			if (was === "pause") setzePause(!pausiert);
			else if (was === "vor") zeige(stelle + 1, true, "eintragen");
			else if (was === "zurueck") zeige(stelle - 1, true, "eintragen");
			else if (was === "vollbild") vollbild();
		});

		document.addEventListener("change", (e) => {
			const feld = (e.target as HTMLElement | null)?.closest<HTMLSelectElement>(
				'[data-db="partei"]',
			);
			if (!feld) return;
			const gewaehlt = ausAuswahl(feld);
			setzeMeinePartei(gewaehlt);
			themaAnwenden(gewaehlt);
			// Der Zeiger gehörte zum alten Topic; das neue wird eingenordet.
			zeiger.setze(undefined);
			document.dispatchEvent(new CustomEvent("wahlen:partei"));
			if (gewaehlt) spiele("jubel");
		});

		document.addEventListener("keydown", (e) => {
			if (!buehne()) return;
			const feld = document.activeElement?.tagName;
			if (feld === "INPUT" || feld === "TEXTAREA" || feld === "SELECT") return;
			if (e.key === " " || e.key === "Spacebar") {
				e.preventDefault();
				setzePause(!pausiert);
			} else if (e.key === "ArrowRight") {
				e.preventDefault();
				zeige(stelle + 1, true, "eintragen");
			} else if (e.key === "ArrowLeft") {
				e.preventDefault();
				zeige(stelle - 1, true, "eintragen");
			} else if (e.key === "f" || e.key === "F") {
				vollbild();
			}
		});

		document.addEventListener("fullscreenchange", () => {
			const drin = Boolean(document.fullscreenElement) && Boolean(buehne());
			if (drin) document.documentElement.dataset.vollbild = "dashboard";
			else document.documentElement.removeAttribute("data-vollbild");
			void wachhalten(drin);
		});

		document.addEventListener("visibilitychange", () => {
			if (document.visibilityState === "visible") begonnen = Date.now();
			if (document.fullscreenElement) void wachhalten(true);
		});

		document.addEventListener("dblclick", (e) => {
			if ((e.target as HTMLElement | null)?.closest(".db-folien"))
				setzePause(!pausiert);
		});
	};

	const starte = (): void => {
		const b = buehne();
		if (uhr) clearInterval(uhr);
		uhr = undefined;
		if (!b) {
			document.documentElement.removeAttribute("data-vollbild");
			void wachhalten(false);
			zeiger.setze(undefined);
			return;
		}
		binde();
		b.dataset.pausiert = pausiert ? "1" : "0";
		zeigeTon();
		zeigePartei();
		zeigeStimmhinweis();
		zeigeTonsperre();
		const ausAdresse = stelleAusAdresse(b);
		zeige(ausAdresse >= 0 ? ausAdresse : stelle, ausAdresse >= 0);
		uhr = setInterval(schlag, 250);
	};

	document.addEventListener("astro:after-swap", () => {
		if (document.fullscreenElement)
			document.documentElement.dataset.vollbild = "dashboard";
		zeigeTonsperre();
	});

	window.addEventListener("popstate", () => {
		const b = buehne();
		if (!b) return;
		const i = stelleAusAdresse(b);
		if (i >= 0) zeige(i, true, "keine");
	});

	document.addEventListener("astro:page-load", starte);
</script>
