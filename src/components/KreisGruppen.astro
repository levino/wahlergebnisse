---
import type { Kreis } from "../data/kreise.ts";
import { kreisPfad, kreiseSortiert } from "../lib/pfade.ts";

interface Props {
	aktuell?: Kreis;
	/** Rasterklassen für die Linkliste – im Kopf enger als auf der Seite */
	spalten?: string;
}
const { aktuell, spalten = "grid-cols-2 sm:grid-cols-3" } = Astro.props;
const alle = kreiseSortiert();
const gruppen = [
	{
		titel: "Ergebnisse liegen vor",
		hinweis: undefined as string | undefined,
		kreise: alle.filter((k) => k.vorhanden),
	},
	{
		titel: "Liegen nicht vor",
		hinweis:
			"Hier ist von diesen Wahlleitungen nichts abzuholen. Woran es liegt, steht auf der Seite des Kreises.",
		kreise: alle.filter((k) => !k.vorhanden),
	},
].filter((g) => g.kreise.length > 0);
---

{gruppen.map((g) => (
	<section class="mt-4 first:mt-0">
		<h2 class="font-bold text-xs uppercase tracking-wide opacity-60">{g.titel}</h2>
		{g.hinweis && <p class="text-xs opacity-60">{g.hinweis}</p>}
		<ul class:list={["mt-1 grid gap-x-4", spalten]}>
			{g.kreise.map((k) => (
				<li>
					<a
						href={kreisPfad(k.slug)}
						aria-current={k.slug === aktuell?.slug ? "true" : undefined}
						class:list={[
							"block py-1 hover:underline truncate",
							k.slug === aktuell?.slug && "font-bold",
							!k.vorhanden && "opacity-60",
						]}
						title={k.hinweis ? `${k.name} – ${k.hinweis}` : k.name}
					>
						{k.kurz}
					</a>
				</li>
			))}
		</ul>
	</section>
))}
