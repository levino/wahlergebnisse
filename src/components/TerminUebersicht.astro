---
/** Startseite eines Termins: Kreiswahlen, Ticker, Gemeinden mit Fortschritt. */
import type { Termin } from "../data/termine.ts";
import type { Kreis } from "../data/kreise.ts";
import {
	ereignisse,
	fortschritt,
	kreiswahlen,
	letzterLauf,
} from "../lib/abfragen.ts";
import { behoerdePfad, wahlPfad } from "../lib/pfade.ts";
import { parteiFarbe } from "../lib/farben.ts";
import { formatProzent, formatZeit } from "../lib/zahlen.ts";
import Balken from "./Balken.astro";
import Fortschritt from "./Fortschritt.astro";
import Ticker from "./Ticker.astro";

interface Props {
	termin: Termin;
	kreis: Kreis;
}
const { termin, kreis } = Astro.props;
// Die Datenbank hält alle Kreise; hier zählt nur dieser. Deshalb überall die
// Behörden dieses Kreises mitgeben statt der globalen Liste.
const kreisBehoerde =
	kreis.behoerden.find((b) => b.ags === kreis.ags) ?? kreis.behoerden[0];
const gemeindeBehoerden = kreis.behoerden.filter((b) => b.ags !== kreis.ags);
const wahlen = kreiswahlen(termin.id, kreis.ags);
const gemeinden = fortschritt(termin.id, gemeindeBehoerden);
const daten = wahlen.length > 0 || gemeinden.some((g) => g.wahlen.length > 0);
const ticker = termin.live
	? ereignisse(
			termin.id,
			25,
			kreis.behoerden.map((b) => b.ags),
		)
	: [];
const lauf = letzterLauf(termin.id);
const gesamtAnz = gemeinden.reduce((a, g) => a + g.anz, 0);
const gesamtMax = gemeinden.reduce((a, g) => a + g.max, 0);
// Manche Termine betreffen nur einzelne Kommunen (Bürgermeisterwahlen laufen
// versetzt zur Ratsperiode). Dann gibt es keine kreisweiten Wahlen, und die
// Seite zeigt allein die betroffenen Gemeinden.
const nurGemeinden = gemeinden.filter((g) => g.wahlen.length > 0);
const kreisweit = wahlen.length > 0;
---

<header class="mb-6">
	<h1 class="text-3xl font-bold">{termin.titel}</h1>
	<p class="opacity-80">{termin.beschreibung}</p>
	{termin.live && gesamtMax > 0 && (
		<div class="mt-3 max-w-xl">
			<Fortschritt anz={gesamtAnz} max={gesamtMax} label={`${gesamtAnz} von ${gesamtMax} Wahlbezirken kreisweit (${Math.round((gesamtAnz / gesamtMax) * 100)} %)`} />
		</div>
	)}
</header>

{!daten && (
	<div class="bg-base-100 p-6 mb-6">
		<p class="font-semibold">Die Daten dieses Termins sind noch nicht geladen.</p>
		<p class="text-sm opacity-70 mt-1">Der Abgleich mit der Wahlpräsentation der Wahlleitung läuft automatisch; diese Seite aktualisiert sich von selbst.{lauf?.fehler && ` Letzter Lauf mit Fehlern: ${lauf.fehler.split("\n")[0]}`}</p>
	</div>
)}

<div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
	<!-- min-w-0: ohne das wachsen Rasterkinder auf ihre Inhaltsbreite und schieben
	     auf schmalen Bildschirmen die ganze Seite auseinander. -->
	<div class="min-w-0 xl:col-span-2 space-y-4">
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			{wahlen.map(({ eintrag, ergebnis }) => (
				<section class="bg-base-100 p-4 flex flex-col">
					<h2 class="font-bold text-lg">
						<a href={wahlPfad(kreis.slug, termin.id, kreisBehoerde.slug, eintrag.slug)} class="hover:underline">{eintrag.kurz}</a>
					</h2>
					<p class="text-xs opacity-70 mb-2 flex flex-wrap items-baseline gap-x-1.5">
						<span>{eintrag.gebietTitel}</span>
						{ergebnis?.ergebnis.zeitstempel && (
							<>
								<span class="opacity-50" aria-hidden="true">·</span>
								<span>{`Stand ${formatZeit(ergebnis.ergebnis.zeitstempel)}`}</span>
							</>
						)}
					</p>
					<Fortschritt anz={ergebnis?.standAnz} max={ergebnis?.standMax} klein />
					<div class="mt-3 flex-1">
						<Balken
							balken={(ergebnis?.ergebnis.parteien ?? []).slice(0, 6).map((p) => ({ ...p, farbe: parteiFarbe(p.key, p.farbe) }))}
							personenwahl={ergebnis?.ergebnis.personenwahl ?? false}
							kompakt
						/>
					</div>
					{ergebnis?.ergebnis.kennzahlen.wahlbeteiligung !== undefined && <p class="text-xs opacity-70 mt-2">Wahlbeteiligung {formatProzent(ergebnis.ergebnis.kennzahlen.wahlbeteiligung)}</p>}
					<a href={wahlPfad(kreis.slug, termin.id, kreisBehoerde.slug, eintrag.slug)} class="btn btn-sm btn-neutral mt-3 self-start">Karte, Sitze, Gemeinden →</a>
				</section>
			))}
		</div>

		{nurGemeinden.length > 0 && (
			<section class="bg-base-100 p-4">
				<h2 class="font-bold text-lg mb-3">
					{kreisweit ? "Städte und Gemeinden" : "Betroffene Kommunen"}
				</h2>
				<ul class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
					{nurGemeinden.map((g) => (
						<li class="min-w-0">
							<a href={behoerdePfad(kreis.slug, termin.id, g.behoerde.slug)} class="font-semibold hover:underline">{g.behoerde.name}</a>
							<Fortschritt anz={g.anz} max={g.max} klein />
							<p class="text-xs opacity-70 truncate">
								{g.wahlen.filter((w) => w.typ === "buergermeister" || w.typ === "rat").map((w) => w.kurz).join(" · ")}
								{g.wahlen.some((w) => w.typ === "ortsrat") && ` · ${g.wahlen.filter((w) => w.typ === "ortsrat").length} Ortsräte`}
							</p>
						</li>
					))}
				</ul>
			</section>
		)}
	</div>
	<div class="min-w-0">
		{termin.live ? <Ticker ereignisse={ticker} kreis={kreis.slug} terminId={termin.id} /> : (
			<section class="bg-base-100 p-4 text-sm">
				<h2 class="font-bold text-lg mb-2">Archiv</h2>
				<p class="opacity-80">Amtliche Endergebnisse der {termin.titel}. Am Wahlabend 2026 dienen sie als Vergleichswerte auf jeder Seite.</p>
			</section>
		)}
	</div>
</div>
