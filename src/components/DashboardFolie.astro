---
/**
 * Eine Folie des Wahlabend-Dashboards: eine Wahl, groß genug für den Beamer.
 *
 * **Das Ergebnis ist die Folie, der Auszählstand ist die Fußnote.** Beides
 * gehört auf die Leinwand, aber nicht gleich groß: Wer im Saal hinsieht, will
 * wissen, wer vorn liegt; wie viele Schnellmeldungen dafür vorliegen, ist die
 * Einordnung dazu und steht deshalb in derselben Zeile wie „Zwischenstand“ oder
 * „Hochrechnung“ – dort, wo es gebraucht wird, und in der Größe, die ihm
 * zusteht. Die Fläche gehört den Balken.
 *
 * Alle Größen stehen in `cqmin`, bezogen auf die Bühne (`.db-buehne` setzt
 * `container-type: size`). Dadurch wächst die Schrift mit der Fläche: im
 * Fenster ist die Folie ein Kasten auf der Seite, im Vollbild füllt sie die
 * Leinwand – und in beiden Fällen stimmt das Verhältnis von Ortsnamen,
 * Balken und Fußzeile, ohne dass es zwei Layouts bräuchte.
 */
import type { Folie, WahlFolie } from "../lib/dashboard.ts";
import { demoAn } from "../lib/demo.ts";
import { formatDiff, formatProzent, formatZahl } from "../lib/zahlen.ts";

interface Props {
	folie: Folie;
	aktiv: boolean;
	nummer: number;
	gesamt: number;
}
const { folie, aktiv, nummer, gesamt } = Astro.props;
// In der Generalprobe gehört der Hinweis in die Folie selbst und nicht bloß
// an den Seitenrand: Was von der Leinwand weitergereicht wird, ist ein Foto
// dieser Fläche.
const demo = demoAn();
const anteil = (anz: number, max: number) =>
	max > 0 ? Math.min(100, Math.round((anz / max) * 100)) : 0;
/**
 * Die Balken sind auf den stärksten Wert bezogen, nicht auf 100 Prozent – wie
 * auf der Wahlseite auch. Bei einer Ratswahl liegt der Sieger bei 40 Prozent;
 * auf die volle Breite bezogen bliebe die halbe Fläche leer, und auf der
 * Leinwand ist Fläche das, was von weitem wirkt.
 */
const balkenMax = Math.max(1, ...folie.balken.map((b) => b.prozent));
/**
 * Höhe der rechten Spalte in Vielfachen ihrer Grundschrift – die Zahl, mit der
 * `.db-seite` ihre Schriftgröße bestimmt (siehe Dashboard.astro). Die
 * Summanden sind die Blöcke, wie sie dort gesetzt sind: Wahlbeteiligung,
 * Sitzliste, dazwischen ein Abstand. Die Sitzliste bricht um, deshalb steckt
 * in ihr eine Schätzung von knapp zwei Einträgen je Zeile.
 */
const seitenHoehe = (f: WahlFolie): number => {
	let h = 0;
	if (f.wahlbeteiligung !== undefined)
		h += (f.wahlbeteiligungVorher !== undefined ? 6 : 4.5) + 1.1;
	if (f.sitze)
		h +=
			1.1 +
			3.6 +
			Math.ceil(f.sitze.verteilung.filter((v) => v.sitze > 0).length / 1.8) *
				1.6;
	return Math.max(6, h);
};
/** Hat die rechte Spalte überhaupt etwas zu zeigen? */
const hatSeite = (f: WahlFolie): boolean =>
	f.wahlbeteiligung !== undefined || Boolean(f.sitze);
---

{/*
   `data-anz`, `data-max`, `data-art`, `data-spitze`: Woran das Karussell
   erkennt, was seit dem letzten Seitentausch passiert ist – daraus entstehen
   die Einblender (siehe Dashboard.astro). Im Server-HTML steht das alles
   ohnehin; hier steht es noch einmal maschinenlesbar, statt es aus der
   Darstellung zurückgelesen zu werden.
*/}
<article
	class:list={["db-folie", aktiv && "db-folie--aktiv"]}
	data-key={folie.key}
	data-marke={folie.marke}
	data-nummer={nummer}
	data-href={folie.href}
	data-anz={folie.anz}
	data-max={folie.max}
	data-art={folie.datenstand.art}
	data-ort={folie.ort}
	data-wahl={folie.wahl}
	data-spitze={folie.balken[0]?.name}
	data-spitze-prozent={folie.balken[0]?.prozent}
	aria-hidden={aktiv ? undefined : "true"}
>
	{/* Die Überschrift führt in die volle Wahlseite: Wer im Saal
	    genauer hinsehen will, hält an und klickt sie an. */}
	<a class="db-titel db-kopf" href={folie.href}>
		<p class="db-wahl">
			<span>{folie.wahl}</span>
			{folie.zuschnitt === "kreis" && <span class="db-marke">ganzer Kreis</span>}
			{folie.beisatz && <span class="db-marke">{folie.beisatz}</span>}
			{folie.test && <span class="db-marke db-marke--warn">Testdatensatz</span>}
		</p>
		<h2 class="db-ort">{folie.ort}</h2>
	</a>

	{/* Zwischenstand, Hochrechnung oder Endergebnis – und gleich daneben,
	    kleiner, woraus die Zahlen stammen. Der Auszählstand sagt, wie
	    ernst die Balken zu nehmen sind; er ist nicht selbst das
	    Ergebnis und bekommt deshalb auch nicht dessen Platz. */}
	<p class:list={["db-band", `db-band--${folie.datenstand.art}`]}>
		<strong>
			{folie.datenstand.art === "endergebnis" ? "✓ " : folie.datenstand.art === "hochrechnung" ? "≈ " : "… "}
			{folie.datenstand.titel}
		</strong>
		{folie.datenstand.unsicherheit && <span class="db-unsicher">Unsicherheit {folie.datenstand.unsicherheit}</span>}
		<span class="db-stand">
			<span>{folie.max > 0 ? `${folie.anz} von ${folie.max} Schnellmeldungen` : "noch keine Schnellmeldung"}</span>
			<span class="db-mini db-stand-balken">
				<span class:list={["db-mini-fuellung", folie.max > 0 && folie.anz >= folie.max && "db-mini-fuellung--fertig"]} style={`width:${anteil(folie.anz, folie.max)}%`}></span>
			</span>
		</span>
	</p>

	<div class="db-inhalt">
		{folie.listen ? (
			/* Der Kreistag wird über Personenstimmen besetzt: Nicht der Sieger
			   je Partei zählt, sondern die Reihenfolge *innerhalb* der Liste.
			   Wer selbst auf einer steht, sieht hier seinen Abstand nach vorn. */
			<div class="db-balken db-listen" style={`--balken:${Math.max(1, folie.listen.length * 2)}`}>
				<p class="db-personen-kopf">{folie.kandidatenTitel}</p>
				<div class="db-listen-raster">
					{folie.listen.map((l) => (
						<section class="db-liste-partei">
							<p class="db-liste-kopf">
								<span class="db-punkt" style={`background:${l.farbe}`}></span>
								<strong>{l.partei}</strong>
							</p>
							<ol class="db-liste-namen">
								{l.kandidaten.map((k, i) => (
									<li class="db-person">
										<span class="db-person-platz">{i + 1}</span>
										<span class="db-person-name">{k.name}</span>
										<span class="db-person-wert">{k.stimmen !== undefined ? formatZahl(k.stimmen) : ""}</span>
									</li>
								))}
							</ol>
							{l.weitere > 0 && <p class="db-weitere">und {l.weitere} weitere</p>}
						</section>
					))}
				</div>
			</div>
		) : folie.kandidaten ? (
			/* Im Kreiswahlbereich entscheidet sich, wer aus dieser Gegend in
			   den Kreistag kommt – nicht, wie der Kreistag zusammengesetzt
			   ist. Deshalb Namen statt Balken. */
			<ol class="db-balken db-personen" style={`--balken:${Math.max(1, folie.kandidaten.length + 1)}`}>
				<li class="db-personen-kopf">{folie.kandidatenTitel}</li>
				{folie.kandidaten.map((k, i) => (
					<li class="db-person">
						<span class="db-person-platz">{i + 1}</span>
						<span class="db-punkt" style={`background:${k.farbe}`}></span>
						<span class="db-person-name">{k.name}</span>
						<span class="db-person-partei">{k.partei}</span>
						<span class="db-person-wert">
							{k.mandat ?? (k.stimmen !== undefined ? `${formatZahl(k.stimmen)} Stimmen` : "")}
						</span>
					</li>
				))}
			</ol>
		) : (
		<ol class="db-balken" style={`--balken:${Math.max(1, folie.balken.length + (folie.weitere > 0 ? 1 : 0))}`}>
			{folie.balken.length === 0 ? (
				<li class="db-leer">Noch keine Stimmen ausgezählt.</li>
			) : folie.balken.map((b) => (
				<li class="db-balken-zeile">
					<span class="db-balken-kopf">
						<span class="db-name">
							{b.name}
							{b.zusatz && <span class="db-zusatz">{b.zusatz}</span>}
						</span>
						<span class="db-werte">
							{b.diff !== undefined && (
								<span class:list={["db-diff", b.diff > 0 ? "db-diff--auf" : b.diff < 0 ? "db-diff--ab" : ""]}>{formatDiff(b.diff)}</span>
							)}
							<strong class="db-prozent">{formatProzent(b.prozent)}</strong>
						</span>
					</span>
					<span class="db-schiene">
						<span class="balken-fuellung db-fuellung" style={`width:${Math.min(100, (b.prozent / balkenMax) * 100)}%;background:${b.farbe}`}></span>
					</span>
				</li>
			))}
			{folie.weitere > 0 && (
				<li class="db-weitere">und {folie.weitere} {folie.weitere === 1 ? "weiterer Eintrag" : "weitere"} mit kleinerem Anteil</li>
			)}
		</ol>
		)}

		{hatSeite(folie) && (
			<aside class="db-seite" style={`--posten:${seitenHoehe(folie)}`}>
				{folie.wahlbeteiligung !== undefined && (
					<div class="db-kennzahl">
						<span class="db-kennzahl-wert">{formatProzent(folie.wahlbeteiligung)}</span>
						<span class="db-kennzahl-label">Wahlbeteiligung</span>
						{folie.wahlbeteiligungVorher !== undefined && (
							<span class="db-kennzahl-fuss">zuvor {formatProzent(folie.wahlbeteiligungVorher)}</span>
						)}
					</div>
				)}

				{folie.sitze && (
					<div class="db-sitze">
						<p class="db-sitze-kopf">
							<span>Sitze</span>
							<strong>{folie.sitze.gesamt}</strong>
							{folie.sitze.quelle === "hochrechnung" && <span class="db-marke db-marke--warn">{folie.sitze.art === "struktur" ? "Hochrechnung" : "Fortschreibung"}</span>}
						</p>
						{/* Ein Band statt eines Halbkreises: Aus fünf Metern zählt
						    niemand Punkte, aber die Mehrheitslinie sieht jeder. */}
						<span class="db-sitzband" role="img" aria-label={folie.sitze.verteilung.filter((v) => v.sitze > 0).map((v) => `${v.kurz} ${v.sitze}`).join(", ")}>
							{folie.sitze.verteilung.filter((v) => v.sitze > 0).map((v) => (
								<span class="db-sitzteil" style={`flex-grow:${v.sitze};background:${v.farbe}`}></span>
							))}
							<span class="db-mehrheit" aria-hidden="true"></span>
						</span>
						<ul class="db-sitzliste">
							{folie.sitze.verteilung.filter((v) => v.sitze > 0).map((v) => (
								<li>
									<span class="db-punkt" style={`background:${v.farbe}`}></span>
									<span>{v.kurz}</span>
									<strong class="db-zahl">{v.sitze}</strong>
									{v.vorher !== undefined && v.vorher !== v.sitze && (
										<span class:list={["db-diff", v.sitze > v.vorher ? "db-diff--auf" : "db-diff--ab"]}>{v.sitze > v.vorher ? "+" : "−"}{Math.abs(v.sitze - v.vorher)}</span>
									)}
								</li>
							))}
						</ul>
					</div>
				)}
			</aside>
		)}
	</div>

	<p class="db-fuss">
		{demo && <span class="db-demo">Demo – keine echten Ergebnisse</span>}
		<span class="db-fuss-links">
			{folie.vergleichTitel && `Veränderung gegenüber ${folie.vergleichTitel}`}
		</span>
		<span class="db-fuss-rechts">{nummer} / {gesamt}</span>
	</p>
</article>
