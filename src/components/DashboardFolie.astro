---
import { type Folie, type WahlFolie, parteiStaende } from "../lib/dashboard.ts";
import { demoAn } from "../lib/demo.ts";
import { kodiereStaende } from "../lib/meldungen.ts";
import { formatDiff, formatProzent, formatZahl } from "../lib/zahlen.ts";

interface Props {
	folie: Folie;
	aktiv: boolean;
	nummer: number;
	gesamt: number;
}
const { folie, aktiv, nummer, gesamt } = Astro.props;
const demo = demoAn();
const anteil = (anz: number, max: number) =>
	max > 0 ? Math.min(100, Math.round((anz / max) * 100)) : 0;
const balkenMax =
	folie.art === "wahl" ? Math.max(1, ...folie.balken.map((b) => b.prozent)) : 1;
const seitenHoehe = (f: WahlFolie): number => {
	let h = 0;
	if (f.wahlbeteiligung !== undefined)
		h += (f.wahlbeteiligungVorher !== undefined ? 6 : 4.5) + 1.1;
	if (f.sitze)
		h +=
			1.1 +
			3.6 +
			Math.ceil(f.sitze.verteilung.filter((v) => v.sitze > 0).length / 1.8) *
				1.6;
	return Math.max(6, h);
};
/** Hat die rechte Spalte überhaupt etwas zu zeigen? */
const hatSeite = (f: WahlFolie): boolean =>
	f.wahlbeteiligung !== undefined || Boolean(f.sitze);
---

<article
	class:list={["db-folie", aktiv && "db-folie--aktiv"]}
	data-key={folie.key}
	data-marke={folie.marke}
	data-nummer={nummer}
	data-href={folie.art === "wahl" ? folie.href : undefined}
	data-ueberblick={folie.art === "ueberblick" ? "" : undefined}
	data-anz={folie.art === "wahl" ? folie.anz : undefined}
	data-max={folie.art === "wahl" ? folie.max : undefined}
	data-art={folie.art === "wahl" ? folie.datenstand.art : undefined}
	data-ort={folie.art === "wahl" ? folie.ort : undefined}
	data-wahl={folie.art === "wahl" ? folie.wahl : undefined}
	data-spitze={folie.art === "wahl" ? folie.balken[0]?.name : undefined}
	data-spitze-prozent={folie.art === "wahl" ? folie.balken[0]?.prozent : undefined}
	data-parteien={folie.art === "wahl" ? kodiereStaende(parteiStaende(folie)) : undefined}
	data-eingegangen={folie.art === "wahl" && folie.eingegangen?.length ? folie.eingegangen.join("|") : undefined}
	aria-hidden={aktiv ? undefined : "true"}
>
	{folie.art === "ueberblick" ? (
	<>
		<header class="db-kopf">
			<p class="db-wahl">{folie.wahl}</p>
			<h2 class="db-ort">{folie.ort}</h2>
		</header>

		<p class="db-band db-band--neutral">
			<strong>Überblick</strong>
			<span class="db-stand">{folie.max > 0 ? `${formatZahl(folie.anz)} von ${formatZahl(folie.max)} Schnellmeldungen ausgezählt` : "Die Auszählung hat noch nicht begonnen"}</span>
		</p>

		<ol
			class:list={["db-liste", folie.zeilen.length > 8 && "db-liste--breit"]}
			style={`--zeilen-schmal:${folie.zeilen.length};--zeilen-breit:${Math.ceil(folie.zeilen.length / 2)}`}
		>
			{folie.zeilen.map((z, i) => (
				<li>
					<a class="db-zeile" href={`#${z.marke}`} data-ziel={nummer + i}>
						<span class="db-zeile-name">
							<strong>{z.ort}</strong>
							<span class="db-zeile-wahl">{z.wahl}</span>
						</span>
						<span class="db-zeile-spitze">
							{z.spitze ? (
								<>
									<span class="db-punkt" style={`background:${z.spitze.farbe}`}></span>
									<span class="db-zeile-partei">{z.spitze.name}</span>
									<strong class="db-zahl">{formatProzent(z.spitze.prozent)}</strong>
								</>
							) : (
								<span class="db-zeile-leer">noch keine Zahlen</span>
							)}
						</span>
						<span class="db-zeile-stand">
							<span class="db-mini">
								<span class:list={["db-mini-fuellung", z.fertig && "db-mini-fuellung--fertig"]} style={`width:${anteil(z.anz, z.max)}%`}></span>
							</span>
							<span class="db-zahl">{z.max > 0 ? `${z.anz}/${z.max}` : "–"}</span>
						</span>
					</a>
				</li>
			))}
		</ol>
	</>
	) : (
	<>
	<a class="db-titel db-kopf" href={folie.href}>
		<p class="db-wahl">
			<span>{folie.wahl}</span>
			{folie.zuschnitt === "kreis" && <span class="db-marke">ganzer Kreis</span>}
			{folie.beisatz && <span class="db-marke">{folie.beisatz}</span>}
			{folie.test && <span class="db-marke db-marke--warn">Testdatensatz</span>}
		</p>
		<h2 class="db-ort">{folie.ort}</h2>
	</a>

	<p class:list={["db-band", `db-band--${folie.datenstand.art}`]}>
		<strong>
			{folie.datenstand.art === "endergebnis" ? "✓ " : folie.datenstand.art === "hochrechnung" ? "≈ " : folie.datenstand.art === "teilgebiet" ? "⚠ " : "… "}
			{folie.datenstand.titel}
		</strong>
		{folie.deckung && <span class="db-unsicher">{folie.deckung.fehlend.length} von {folie.deckung.kommunen} Kommunen fehlen</span>}
		{folie.datenstand.unsicherheit && <span class="db-unsicher">Unsicherheit {folie.datenstand.unsicherheit}</span>}
		<span class="db-stand">
			<span>{folie.max > 0 ? `${folie.anz} von ${folie.max} Schnellmeldungen${folie.deckung ? " laut Quelle" : ""}` : "noch keine Schnellmeldung"}</span>
			<span class="db-mini db-stand-balken">
				<span class:list={["db-mini-fuellung", folie.max > 0 && folie.anz >= folie.max && !folie.deckung && "db-mini-fuellung--fertig"]} style={`width:${anteil(folie.anz, folie.max)}%`}></span>
			</span>
		</span>
	</p>

	<div class="db-inhalt">
		{folie.listen ? (
			<div class="db-balken db-listen" style={`--balken:${Math.max(1, folie.listen.length * 2)}`}>
				<p class="db-personen-kopf">{folie.kandidatenTitel}</p>
				<div class="db-listen-raster">
					{folie.listen.map((l) => (
						<section class="db-liste-partei">
							<p class="db-liste-kopf">
								<span class="db-punkt" style={`background:${l.farbe}`}></span>
								<strong>{l.partei}</strong>
							</p>
							<ol class="db-liste-namen">
								{l.kandidaten.map((k, i) => (
									<li class="db-person">
										<span class="db-person-platz">{i + 1}</span>
										<span class="db-person-name">{k.name}</span>
										<span class="db-person-wert">{k.stimmen !== undefined ? formatZahl(k.stimmen) : ""}</span>
									</li>
								))}
							</ol>
							{l.weitere > 0 && <p class="db-weitere">und {l.weitere} weitere</p>}
						</section>
					))}
				</div>
			</div>
		) : folie.kandidaten ? (
			<ol class="db-balken db-personen" style={`--balken:${Math.max(1, folie.kandidaten.length + 1)}`}>
				<li class="db-personen-kopf">{folie.kandidatenTitel}</li>
				{folie.kandidaten.map((k, i) => (
					<li class="db-person">
						<span class="db-person-platz">{i + 1}</span>
						<span class="db-punkt" style={`background:${k.farbe}`}></span>
						<span class="db-person-name">{k.name}</span>
						<span class="db-person-partei">{k.partei}</span>
						<span class="db-person-wert">
							{k.mandat ?? (k.stimmen !== undefined ? `${formatZahl(k.stimmen)} Stimmen` : "")}
						</span>
					</li>
				))}
			</ol>
		) : (
		<ol class="db-balken" style={`--balken:${Math.max(1, folie.balken.length + (folie.weitere > 0 ? 1 : 0))}`}>
			{folie.balken.length === 0 ? (
				<li class="db-leer">Noch keine Stimmen ausgezählt.</li>
			) : folie.balken.map((b) => (
				<li class="db-balken-zeile">
					<span class="db-balken-kopf">
						<span class="db-name">
							{b.name}
							{b.zusatz && <span class="db-zusatz">{b.zusatz}</span>}
						</span>
						<span class="db-werte">
							{b.diff !== undefined && (
								<span class:list={["db-diff", b.diff > 0 ? "db-diff--auf" : b.diff < 0 ? "db-diff--ab" : ""]}>{formatDiff(b.diff)}</span>
							)}
							<strong class="db-prozent">{formatProzent(b.prozent)}</strong>
						</span>
					</span>
					<span class="db-schiene">
						<span class="balken-fuellung db-fuellung" style={`width:${Math.min(100, (b.prozent / balkenMax) * 100)}%;background:${b.farbe}`}></span>
					</span>
				</li>
			))}
			{folie.weitere > 0 && (
				<li class="db-weitere">und {folie.weitere} {folie.weitere === 1 ? "weiterer Eintrag" : "weitere"} mit kleinerem Anteil</li>
			)}
		</ol>
		)}

		{hatSeite(folie) && (
			<aside class="db-seite" style={`--posten:${seitenHoehe(folie)}`}>
				{folie.wahlbeteiligung !== undefined && (
					<div class="db-kennzahl">
						<span class="db-kennzahl-wert">{formatProzent(folie.wahlbeteiligung)}</span>
						<span class="db-kennzahl-label">Wahlbeteiligung</span>
						{folie.wahlbeteiligungVorher !== undefined && (
							<span class="db-kennzahl-fuss">zuvor {formatProzent(folie.wahlbeteiligungVorher)}</span>
						)}
					</div>
				)}

				{folie.sitze && (
					<div class="db-sitze">
						<p class="db-sitze-kopf">
							<span>Sitze</span>
							<strong>{folie.sitze.gesamt}</strong>
							{folie.sitze.quelle === "hochrechnung" && <span class="db-marke db-marke--warn">{folie.sitze.art === "struktur" ? "Hochrechnung" : "Fortschreibung"}</span>}
						</p>
						<span class="db-sitzband" role="img" aria-label={folie.sitze.verteilung.filter((v) => v.sitze > 0).map((v) => `${v.kurz} ${v.sitze}`).join(", ")}>
							{folie.sitze.verteilung.filter((v) => v.sitze > 0).map((v) => (
								<span class="db-sitzteil" style={`flex-grow:${v.sitze};background:${v.farbe}`}></span>
							))}
							<span class="db-mehrheit" aria-hidden="true"></span>
						</span>
						<ul class="db-sitzliste">
							{folie.sitze.verteilung.filter((v) => v.sitze > 0).map((v) => (
								<li>
									<span class="db-punkt" style={`background:${v.farbe}`}></span>
									<span>{v.kurz}</span>
									<strong class="db-zahl">{v.sitze}</strong>
									{v.vorher !== undefined && v.vorher !== v.sitze && (
										<span class:list={["db-diff", v.sitze > v.vorher ? "db-diff--auf" : "db-diff--ab"]}>{v.sitze > v.vorher ? "+" : "−"}{Math.abs(v.sitze - v.vorher)}</span>
									)}
								</li>
							))}
						</ul>
					</div>
				)}
			</aside>
		)}
	</div>
	</>
	)}

	<p class="db-fuss">
		{demo && <span class="db-demo">Demo – keine echten Ergebnisse</span>}
		<span class="db-fuss-links">
			{folie.art === "wahl" && folie.vergleichTitel && `Veränderung gegenüber ${folie.vergleichTitel}`}
		</span>
		<span class="db-fuss-rechts">{nummer} / {gesamt}</span>
	</p>
</article>
