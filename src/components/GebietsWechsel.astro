---
/**
 * Umschalter im Kopf: andere Wahl (möglichst im selben Gebiet) und anderes
 * Gebiet derselben Wahl.
 *
 * Das Gebiets-Menü zeigt den Baum eingerückt: bei der Kreistagswahl also
 * Wahlbereich, darunter seine Gemeinden, Ortsteile und Wahllokale. So kommt
 * man mit einem Griff von einem Wahllokal zum nächsten. Ein <select> braucht
 * dafür kein eigenes Bündel und funktioniert auch ohne JavaScript als Liste.
 */
import { alsAuswahl, type Gebietsknoten } from "../lib/gebietsbaum.ts";

interface Props {
	wahlLinks: Array<{
		slug: string;
		label: string;
		href: string;
		aktiv: boolean;
	}>;
	gebiete: Gebietsknoten[];
	gesamtTitel: string;
	gesamtHref: string;
	istGesamt: boolean;
}
const { wahlLinks, gebiete, gesamtTitel, gesamtHref, istGesamt } = Astro.props;
const auswahl = alsAuswahl(gebiete);
const einzug = (tiefe: number) => "\u00a0\u00a0".repeat(tiefe);
---

<div class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-4">
	<nav class="flex flex-wrap gap-1 text-sm" aria-label="Wahl wechseln">
		{wahlLinks.map((w) => (
			<a
				href={w.href}
				class:list={[
					"px-3 py-1.5 border",
					w.aktiv
						? "bg-rhoendorf text-white border-rhoendorf font-semibold"
						: "bg-base-100 hover:bg-base-300 border-base-300",
				]}
			>
				{w.label}
			</a>
		))}
	</nav>

	{auswahl.length > 0 && (
		<label class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm w-full sm:w-auto">
			<span class="opacity-70">Gebiet</span>
			<select
				class="select select-sm select-bordered w-full sm:w-auto sm:max-w-[22rem] min-w-0"
				data-gebietswechsel
				aria-label="Anderes Gebiet anzeigen"
			>
				<option value={gesamtHref} selected={istGesamt}>{gesamtTitel} (gesamt)</option>
				{auswahl.map((g) => (
					<option value={g.href} selected={g.aktiv}>{`${einzug(g.tiefe)}${g.titel}`}</option>
				))}
			</select>
		</label>
	)}
</div>

<script>
	// Auswahl im Gebiets-Menü führt zur Seite des Gebiets – über den
	// Astro-Router, damit die Karte stehen bleibt und die Seite nicht springt.
	import { navigate } from "astro:transitions/client";

	const binde = () => {
		for (const el of document.querySelectorAll<HTMLSelectElement>("[data-gebietswechsel]")) {
			if (el.dataset.gebunden) continue;
			el.dataset.gebunden = "1";
			el.addEventListener("change", () => {
				if (el.value) void navigate(el.value);
			});
		}
	};
	binde();
	document.addEventListener("astro:page-load", binde);
</script>
