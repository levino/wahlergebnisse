---
/**
 * Umschalter im Kopf: welcher Kreis gerade gezeigt wird und wie man zu einem
 * anderen kommt.
 *
 * Der Kreis steht bewusst nicht in den Brotkrumen – er ist keine Ebene über
 * dem Termin, sondern der Rahmen, in dem man arbeitet. Bei 45 Einträgen wäre
 * eine bloße Liste im Kopf zu lang, deshalb ein <details>-Aufklapper: zu ein
 * Wort, offen ein Suchfeld mit <datalist> und darunter alle Kreise als Links.
 *
 * Beides kommt ohne JavaScript aus: <details> klappt von selbst auf, das
 * Formular geht als GET an /wechsel, und die Links tun es auch ohne Formular.
 * Kreise ohne nutzbare Präsentation stehen in einer eigenen Gruppe – sie sind
 * erreichbar, aber man sieht vorher, dass dort nichts vorliegt.
 */
import type { Kreis } from "../data/kreise.ts";
import { kreiseSortiert } from "../lib/pfade.ts";
import KreisGruppen from "./KreisGruppen.astro";

interface Props {
	aktuell?: Kreis;
}
const { aktuell } = Astro.props;
const alle = kreiseSortiert();
---

<details class="relative text-sm">
	<summary class="cursor-pointer list-none px-3 py-1.5 rounded-sm bg-white/15 hover:bg-white/25 select-none">
		<span class="opacity-80">Kreis:</span>
		<span class="font-semibold">{aktuell ? aktuell.kurz : "auswählen"}</span>
		<span aria-hidden="true" class="opacity-70">▾</span>
	</summary>

	<div class="absolute z-30 mt-2 left-0 w-[min(92vw,44rem)] max-h-[70vh] overflow-y-auto bg-base-100 text-unionsschwarz shadow-lg border border-base-300 p-4">
		<form method="get" action="/wechsel" class="flex flex-wrap items-end gap-2">
			<label class="flex flex-col gap-1 flex-1 min-w-[12rem]">
				<span class="opacity-70">Kreis suchen</span>
				<input
					type="text"
					name="kreis"
					list="kreis-vorschlaege"
					autocomplete="off"
					placeholder="z. B. Hildesheim"
					class="input input-sm input-bordered w-full"
				/>
			</label>
			<button type="submit" class="btn btn-sm btn-neutral">Wechseln</button>
		</form>
		<datalist id="kreis-vorschlaege">
			{alle.map((k) => <option value={k.kurz}>{k.name}</option>)}
		</datalist>

		<KreisGruppen aktuell={aktuell} />
	</div>
</details>
