---
/**
 * Balkendiagramm der Parteien bzw. Kandidaten mit Prozent, Stimmen, ggf.
 * Veränderung zur Vergleichswahl und Sitzen.
 */
import type { BalkenModell } from "../lib/seite.ts";
import { formatDiff, formatProzent, formatZahl } from "../lib/zahlen.ts";

interface Props {
	balken: BalkenModell[];
	personenwahl: boolean;
	vergleichTitel?: string;
	kompakt?: boolean;
}
const { balken, personenwahl, vergleichTitel, kompakt = false } = Astro.props;
const max = Math.max(1, ...balken.map((b) => b.prozent));
const hatVergleich = balken.some((b) => b.diff !== undefined);
---

{balken.length === 0 ? (
	<p class="text-sm opacity-70">Noch keine Stimmen ausgezählt.</p>
) : (
	<ol class:list={["space-y-2", kompakt && "space-y-1"]}>
		{balken.map((b) => (
			<li>
				{/* Auf schmalen Geräten stehen Name und Zahlen untereinander,
				    sonst wird die Zeile breiter als der Bildschirm. */}
				<div class:list={["flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5", kompakt ? "text-sm" : ""]}>
					<span class="font-semibold truncate flex items-baseline gap-2 min-w-0">
						{personenwahl && b.kandidat ? (
							<>
								<span class="truncate">{b.kandidat.name}</span>
								<span class="font-normal opacity-70 shrink-0">{b.kandidat.partei}</span>
							</>
						) : (
							<span class="truncate" title={b.lang}>{b.kurz}</span>
						)}
					</span>
					<span class="whitespace-nowrap tabular-nums flex items-baseline gap-3 shrink-0">
						<span class="font-bold">{formatProzent(b.prozent)}</span>
						{!kompakt && (
							<span class="opacity-70 text-sm">
								<span class="hidden xs:inline">{formatZahl(b.stimmen)} Stimmen</span>
								<span class="xs:hidden">{formatZahl(b.stimmen)}</span>
							</span>
						)}
						{b.diff !== undefined && (
							<span class:list={["text-sm tabular-nums", b.diff > 0 ? "text-green-700" : b.diff < 0 ? "text-red-700" : "opacity-60"]} title={vergleichTitel ? `Veränderung zu ${vergleichTitel}` : undefined}>
								{formatDiff(b.diff)}
							</span>
						)}
						{b.sitze !== undefined && !kompakt && (
							<span class="text-sm opacity-70">{b.sitze === 1 ? "1 Sitz" : `${b.sitze} Sitze`}</span>
						)}
					</span>
				</div>
				<div class:list={["bg-base-300 relative", kompakt ? "h-2" : "h-4"]}>
					<div class="balken-fuellung h-full" style={`width:${(b.prozent / max) * 100}%;background:${b.farbe}`}></div>
					{b.vorher !== undefined && !kompakt && (
						<div class="absolute top-0 h-full border-r-2 border-unionsschwarz/60" style={`left:${(b.vorher / max) * 100}%`} title={`${vergleichTitel ?? "Vergleich"}: ${formatProzent(b.vorher)}`}></div>
					)}
				</div>
			</li>
		))}
	</ol>
)}
{hatVergleich && !kompakt && vergleichTitel && <p class="text-xs opacity-60 mt-2">Markierung und Veränderung im Vergleich zu: {vergleichTitel}</p>}
