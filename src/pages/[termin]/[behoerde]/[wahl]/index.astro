---
import Layout from "../../../../layouts/Layout.astro";
import WahlSeite from "../../../../components/WahlSeite.astro";
import { terminById } from "../../../../data/termine.ts";
import { behoerdeBySlug } from "../../../../data/behoerden.ts";
import { ladeWahlSeite } from "../../../../lib/seite.ts";

export const prerender = false;
const termin = terminById(Astro.params.termin ?? "");
const behoerde = behoerdeBySlug(Astro.params.behoerde ?? "");
const m =
	termin && behoerde
		? ladeWahlSeite(termin, behoerde, Astro.params.wahl ?? "")
		: undefined;
if (!termin || !behoerde || !m)
	return new Response("Nicht gefunden", { status: 404 });
---

<Layout title={`${m.eintrag.kurz} ${m.eintrag.gebietTitel} – ${termin.titel}`} termin={termin} breit pfad={[{ titel: termin.titel, href: `/${termin.id}/` }, { titel: behoerde.name, href: `/${termin.id}/${behoerde.slug}/` }, { titel: m.eintrag.kurz }]}>
	<WahlSeite m={m} />
</Layout>
