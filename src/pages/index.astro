---
/**
 * Einstieg: die Auswahl aller Kreise, für jeden Aufruf dieselbe.
 *
 * Vorher merkte ein Cookie den zuletzt angesehenen Kreis und "/" leitete ein
 * Jahr lang stillschweigend dorthin um. Das war aus zwei Gründen falsch: Es
 * gibt keinen sichtbaren Weg zurück zur Auswahl, und wer über "/" einsteigt,
 * landete unversehens in einem Kreis, in dem es die Archivtermine gar nicht
 * gibt – und hielt sie für verschwunden. Wer immer denselben Kreis ansieht,
 * setzt dessen Adresse als Lesezeichen; die ist stabil.
 */
import Layout from "../layouts/Layout.astro";
import KreisGruppen from "../components/KreisGruppen.astro";
import { kreiseSortiert } from "../lib/pfade.ts";

export const prerender = false;
const unbekannt = Astro.url.searchParams.get("unbekannt");
---

<Layout
	title="Kreis wählen"
	description="Kommunalwahlergebnisse der niedersächsischen Landkreise und kreisfreien Städte."
>
	<h1 class="text-3xl font-bold">Welchen Kreis möchten Sie ansehen?</h1>
	<p class="opacity-80 mt-1">
		Ergebnisse der Kommunalwahlen in Niedersachsen, aufbereitet aus den
		amtlichen Wahlpräsentationen.
	</p>

	{unbekannt && (
		<p class="mt-4 bg-base-100 border-l-4 border-warning p-3 max-w-3xl">
			„{unbekannt}“ ist kein Kreis, den diese Seiten kennen. Bitte aus der
			Liste wählen.
		</p>
	)}

	<form method="get" action="/wechsel" class="mt-6 flex flex-wrap items-end gap-2 max-w-xl">
		<label class="flex flex-col gap-1 flex-1 min-w-[12rem]">
			<span class="text-sm opacity-70">Kreis suchen</span>
			<input
				type="text"
				name="kreis"
				list="kreis-vorschlaege-start"
				autocomplete="off"
				placeholder="z. B. Hildesheim"
				class="input input-bordered w-full"
			/>
		</label>
		<button type="submit" class="btn btn-neutral">Anzeigen</button>
	</form>
	<datalist id="kreis-vorschlaege-start">
		{kreiseSortiert().map((k) => <option value={k.kurz}>{k.name}</option>)}
	</datalist>

	<div class="bg-base-100 p-6 mt-6">
		<KreisGruppen spalten="grid-cols-2 sm:grid-cols-3 lg:grid-cols-4" />
	</div>
</Layout>
