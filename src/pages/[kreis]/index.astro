---
/** Startseite eines Kreises: der laufende Termin, sonst der jüngste. */
import Layout from "../../layouts/Layout.astro";
import TerminUebersicht from "../../components/TerminUebersicht.astro";
import KreisOhneDaten from "../../components/KreisOhneDaten.astro";
import { TERMINE, terminGiltFuerKreis } from "../../data/termine.ts";
import { hatIvuTermin, kreisBySlug, nutztIvu } from "../../data/kreise.ts";
import { kreisVorhanden } from "../../lib/abfragen.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
if (!kreis) return Astro.rewrite("/404");
const termine = TERMINE.filter((t) => terminGiltFuerKreis(t, kreis.slug));
const termin = termine.find((t) => t.live) ?? termine[0];
if (!termin) return Astro.rewrite("/404");
/**
 * Ein IVU-Kreis liefert nur für die Termine, zu denen der Katalog eine
 * Präsentation kennt; sonst ist dort nichts abzuholen.
 */
const angebunden =
	kreisVorhanden(kreis) && (!nutztIvu(kreis) || hatIvuTermin(kreis, termin));
---

{angebunden ? (
	<Layout title={termin.titel} termin={termin} kreis={kreis}>
		<TerminUebersicht termin={termin} kreis={kreis} />
	</Layout>
) : (
	<Layout title={kreis.kurz} kreis={kreis}>
		<KreisOhneDaten kreis={kreis} />
	</Layout>
)}
