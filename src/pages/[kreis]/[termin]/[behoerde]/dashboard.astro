---
/**
 * Das Wahlabend-Dashboard einer Wahlleitung: alle ihre Wahlen im Wechsel,
 * groß genug für den Beamer.
 *
 * Die Adresse liegt bewusst neben den Wahl-Slugs (`…/nordstemmen/dashboard`
 * neben `…/nordstemmen/kreistag`): Astro zieht das feste Segment dem
 * `[wahl]`-Platzhalter vor, und eine Wahl kann nie „dashboard“ heißen – die
 * Slugs entstehen aus Wahlart und Ortsnamen (siehe wahltyp.ts).
 */
import Layout from "../../../../layouts/Layout.astro";
import Dashboard from "../../../../components/Dashboard.astro";
import {
	terminById,
	terminGiltFuerBehoerde,
} from "../../../../data/termine.ts";
import { kreisBySlug } from "../../../../data/kreise.ts";
import {
	behoerdeImKreis,
	behoerdePfad,
	terminKrume,
} from "../../../../lib/pfade.ts";
import { wahleintraege } from "../../../../lib/abfragen.ts";
import {
	kreisebeneFuer,
	ladeDashboard,
	taktAus,
} from "../../../../lib/dashboard.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const termin = terminById(Astro.params.termin ?? "");
const behoerde = kreis
	? behoerdeImKreis(kreis, Astro.params.behoerde ?? "")
	: undefined;
// Wie überall: Die Wahlleitung muss den Termin selbst führen.
if (
	!kreis ||
	!termin ||
	!behoerde ||
	!terminGiltFuerBehoerde(termin, kreis, behoerde)
)
	return Astro.rewrite("/404");

const kreisBehoerde = kreis.behoerden.find((b) => b.ags === kreis.ags);
const m = ladeDashboard(
	kreis,
	termin,
	behoerde,
	wahleintraege(termin.id, behoerde.ags),
	kreisBehoerde ? kreisebeneFuer(termin, kreisBehoerde, behoerde) : undefined,
	taktAus(Astro.url.searchParams.get("takt")),
);
const titel = `Wahlabend ${behoerde.kurz}`;
---

<Layout
	title={titel}
	description={`Alle Wahlen in ${behoerde.kurz} am ${termin.titel} im Wechsel – für die Leinwand am Wahlabend.`}
	termin={termin}
	kreis={kreis}
	breit
	pfad={[terminKrume(kreis, termin), { titel: behoerde.name, href: behoerdePfad(kreis.slug, termin.id, behoerde.slug) }, { titel: "Wahlabend" }]}
>
	{m.folien.length === 0 ? (
		<div class="bg-base-100 p-6">
			<h1 class="text-3xl font-bold">{titel}</h1>
			<p class="mt-2">Für {behoerde.name} liegen zu diesem Termin noch keine Wahlen vor. Sobald die Wahlleitung ihre Präsentation freischaltet, laufen sie hier von selbst durch.</p>
		</div>
	) : (
		<>
			<Dashboard m={m} />
			<div class="nur-fenster mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm opacity-80">
				<p>
					<strong>Für die Leinwand:</strong> „Vollbild“ blendet Menü und Fußzeile aus. Die Folien wechseln alle {m.takt} Sekunden
					(einstellbar über <code>?takt={m.takt}</code> in der Adresse) und aktualisieren sich mit jeder neuen Schnellmeldung von selbst.
				</p>
				<p><a class="underline" href={behoerdePfad(kreis.slug, termin.id, behoerde.slug)}>Alle Wahlen in {behoerde.kurz}</a></p>
			</div>
		</>
	)}
</Layout>
