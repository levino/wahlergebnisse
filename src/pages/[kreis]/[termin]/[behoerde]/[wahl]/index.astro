---
import Layout from "../../../../../layouts/Layout.astro";
import WahlSeite from "../../../../../components/WahlSeite.astro";
import {
	terminById,
	terminGiltFuerBehoerde,
} from "../../../../../data/termine.ts";
import { kreisBySlug } from "../../../../../data/kreise.ts";
import {
	behoerdeImKreis,
	behoerdePfad,
	terminKrume,
} from "../../../../../lib/pfade.ts";
import { ladeWahlSeite } from "../../../../../lib/seite.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const roherTermin = terminById(Astro.params.termin ?? "");
const behoerde = kreis
	? behoerdeImKreis(kreis, Astro.params.behoerde ?? "")
	: undefined;
const termin =
	kreis &&
	behoerde &&
	roherTermin &&
	terminGiltFuerBehoerde(roherTermin, kreis, behoerde)
		? roherTermin
		: undefined;
const m =
	kreis && termin && behoerde
		? ladeWahlSeite(kreis, termin, behoerde, Astro.params.wahl ?? "")
		: undefined;
if (!kreis || !termin || !behoerde || !m) return Astro.rewrite("/404");
---

<Layout title={`${m.eintrag.kurz} ${m.eintrag.gebietTitel} – ${termin.titel}`} termin={termin} kreis={kreis} behoerde={behoerde} breit pfad={[terminKrume(kreis, termin), { titel: behoerde.name, href: behoerdePfad(kreis.slug, termin.id, behoerde.slug) }, { titel: m.eintrag.kurz }]}>
	<WahlSeite m={m} />
</Layout>
