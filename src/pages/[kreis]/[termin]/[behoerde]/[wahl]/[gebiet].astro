---
import Layout from "../../../../../layouts/Layout.astro";
import WahlSeite from "../../../../../components/WahlSeite.astro";
import {
	terminById,
	terminGiltFuerBehoerde,
} from "../../../../../data/termine.ts";
import { kreisBySlug } from "../../../../../data/kreise.ts";
import {
	behoerdeImKreis,
	behoerdePfad,
	terminKrume,
} from "../../../../../lib/pfade.ts";
import { ladeWahlSeite } from "../../../../../lib/seite.ts";
import { topicAus } from "../../../../../lib/stand.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const roherTermin = terminById(Astro.params.termin ?? "");
const behoerde = kreis
	? behoerdeImKreis(kreis, Astro.params.behoerde ?? "")
	: undefined;
const termin =
	kreis &&
	behoerde &&
	roherTermin &&
	terminGiltFuerBehoerde(roherTermin, kreis, behoerde)
		? roherTermin
		: undefined;
const gebiet = Astro.params.gebiet ?? "";
const m =
	kreis && termin && behoerde && /^ebene_-?\d+_id_\d+$/.test(gebiet)
		? ladeWahlSeite(kreis, termin, behoerde, Astro.params.wahl ?? "", gebiet)
		: undefined;
if (!kreis || !termin || !behoerde || !m) return Astro.rewrite("/404");
---

<Layout
	title={`${m.aktuell?.titel ?? gebiet} – ${m.eintrag.kurz} – ${termin.titel}`}
	termin={termin}
	kreis={kreis}
	topic={topicAus(kreis, [behoerde.ags])}
	breit
	pfad={[terminKrume(kreis, termin), { titel: behoerde.name, href: behoerdePfad(kreis.slug, termin.id, behoerde.slug) }, { titel: m.eintrag.kurz, href: m.pfad[0].href }, { titel: m.aktuell?.titel ?? gebiet }]}
>
	<WahlSeite m={m} />
</Layout>
