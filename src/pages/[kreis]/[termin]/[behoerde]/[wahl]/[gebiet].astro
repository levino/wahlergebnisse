---
import Layout from "../../../../../layouts/Layout.astro";
import WahlSeite from "../../../../../components/WahlSeite.astro";
import { terminById } from "../../../../../data/termine.ts";
import { kreisBySlug } from "../../../../../data/kreise.ts";
import {
	behoerdeImKreis,
	terminPfad,
	behoerdePfad,
} from "../../../../../lib/pfade.ts";
import { ladeWahlSeite } from "../../../../../lib/seite.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const termin = terminById(Astro.params.termin ?? "");
const behoerde =
	kreis && termin
		? behoerdeImKreis(kreis, Astro.params.behoerde ?? "")
		: undefined;
const gebiet = Astro.params.gebiet ?? "";
const m =
	kreis && termin && behoerde && /^ebene_-?\d+_id_\d+$/.test(gebiet)
		? ladeWahlSeite(kreis, termin, behoerde, Astro.params.wahl ?? "", gebiet)
		: undefined;
if (!kreis || !termin || !behoerde || !m)
	return new Response("Nicht gefunden", { status: 404 });
---

<Layout
	title={`${m.aktuell?.titel ?? gebiet} – ${m.eintrag.kurz} – ${termin.titel}`}
	termin={termin}
	kreis={kreis}
	breit
	pfad={[{ titel: termin.titel, href: terminPfad(kreis.slug, termin.id) }, { titel: behoerde.name, href: behoerdePfad(kreis.slug, termin.id, behoerde.slug) }, { titel: m.eintrag.kurz, href: m.pfad[0].href }, { titel: m.aktuell?.titel ?? gebiet }]}
>
	<WahlSeite m={m} />
</Layout>
