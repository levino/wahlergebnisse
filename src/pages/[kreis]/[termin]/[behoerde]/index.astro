---
/** Übersicht einer Behörde: alle Wahlen dort mit Kurzergebnis. */
import Layout from "../../../../layouts/Layout.astro";
import Balken from "../../../../components/Balken.astro";
import Fortschritt from "../../../../components/Fortschritt.astro";
import Ticker from "../../../../components/Ticker.astro";
import {
	istLive,
	terminById,
	terminGiltFuerBehoerde,
	praesentationUrl,
} from "../../../../data/termine.ts";
import { kreisBySlug } from "../../../../data/kreise.ts";
import {
	behoerdeImKreis,
	dashboardPfad,
	ortPfad,
	terminKrume,
	wahlPfad,
} from "../../../../lib/pfade.ts";
import { orteDerBehoerde } from "../../../../lib/ort.ts";
import {
	ereignisse,
	ergebnis,
	wahleintraege,
} from "../../../../lib/abfragen.ts";
import { parteiFarbe } from "../../../../lib/farben.ts";
import { staerkste } from "../../../../lib/anzeige.ts";
import { ebenenUeberschriften, istKreiswahl } from "../../../../lib/wahltyp.ts";
import { wahlLabel } from "../../../../lib/seite.ts";
import { topicAus } from "../../../../lib/stand.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const termin = terminById(Astro.params.termin ?? "");
const behoerde = kreis
	? behoerdeImKreis(kreis, Astro.params.behoerde ?? "")
	: undefined;
if (
	!kreis ||
	!termin ||
	!behoerde ||
	!terminGiltFuerBehoerde(termin, kreis, behoerde)
)
	return Astro.rewrite("/404");
const wahlen = wahleintraege(termin.id, behoerde.ags).map((w) => ({
	w,
	e: ergebnis(termin.id, behoerde.ags, w.wahlId, w.gebietId),
}));
const kreisweite = wahlen.filter((x) => istKreiswahl(x.w.typ));
const ebene = ebenenUeberschriften(kreisweite.map((x) => x.w.titel));
const gruppen = [
	{
		titel:
			behoerde.art === "kreis"
				? ebene.eigen
				: `${ebene.kreisweit} ${behoerde.kurz}`,
		eintraege: kreisweite,
	},
	{
		titel: "Gemeindeebene",
		eintraege: wahlen.filter(
			(x) => !istKreiswahl(x.w.typ) && x.w.typ !== "ortsrat",
		),
	},
	{ titel: "Ortsräte", eintraege: wahlen.filter((x) => x.w.typ === "ortsrat") },
].filter((g) => g.eintraege.length);
const label = wahlLabel;
const orte = orteDerBehoerde(
	termin.id,
	behoerde,
	wahlen.map((x) => x.w),
);
const ticker = istLive(termin) ? ereignisse(termin.id, 20, behoerde.ags) : [];
const quelle = praesentationUrl(
	termin,
	behoerde.ags,
	behoerde.wurzel ?? kreis.basis,
);
---

<Layout title={`${behoerde.name} – ${termin.titel}`} termin={termin} kreis={kreis} topic={topicAus(kreis, [behoerde.ags])} pfad={[terminKrume(kreis, termin), { titel: behoerde.name }]}>
	<h1 class="text-3xl font-bold">{behoerde.name}</h1>
	<p class="opacity-80 mb-3">{termin.titel} · <a class="underline" href={quelle} target="_blank" rel="noopener">amtliche Präsentation</a></p>
	{wahlen.length > 0 && (
		<p class="mb-6">
			<a class="btn btn-primary btn-sm" href={dashboardPfad(kreis.slug, termin.id, behoerde.slug)}>
				Wahlabend-Dashboard
			</a>
			<span class="ml-2 text-sm opacity-70">Alle Wahlen im Wechsel, für Beamer und Vollbild</span>
		</p>
	)}

	{wahlen.length === 0 && <p class="bg-base-100 p-6">Für diese Behörde liegen noch keine Daten vor.</p>}

	<div class="grid gap-4 xl:grid-cols-3">
		<div class="xl:col-span-2 space-y-6">
			{gruppen.map((g) => (
				<section>
					<h2 class="font-bold text-xl mb-2">{g.titel}</h2>
					<div class="grid gap-4 md:grid-cols-2">
						{g.eintraege.map(({ w, e }) => (
							<article class="bg-base-100 p-4 flex flex-col">
								<h3 class="font-bold text-lg"><a href={wahlPfad(kreis.slug, termin.id, behoerde.slug, w.slug)} class="hover:underline">{label(w)}</a></h3>
								{w.test && <p class="badge badge-warning badge-sm mt-1">Testdatensatz der Wahlleitung</p>}
								<Fortschritt anz={e?.standAnz} max={e?.standMax} klein />
								<div class="mt-2 flex-1">
									{/* Gekürzt auf fünf – also die fünf stärksten, nicht die fünf erstgenannten. */}
									<Balken balken={staerkste(e?.ergebnis.parteien ?? [], 5).map((p) => ({ ...p, farbe: parteiFarbe(p.key, p.farbe) }))} personenwahl={e?.ergebnis.personenwahl ?? false} kompakt />
								</div>
								{e?.ergebnis.sitze && <p class="text-xs opacity-70 mt-2">{e.ergebnis.sitze.gesamt} Sitze vergeben</p>}
							</article>
						))}
					</div>
				</section>
			))}
		</div>
		<div class="space-y-4">
			{orte.length > 0 && (
				<section class="bg-base-100 p-4">
					<h2 class="font-bold text-lg mb-1">Ergebnisse nach Ortschaft</h2>
					<p class="text-sm opacity-70 mb-3">Alle Wahlen dieses Abends, wie sie in einem Ort ausgegangen sind.</p>
					<ul class="flex flex-wrap gap-1">
						{orte.map((o) => (
							<li>
								<a href={ortPfad(kreis.slug, termin.id, behoerde.slug, o.slug)} class="inline-block px-3 py-1.5 text-sm bg-base-200 hover:bg-base-300">{o.name}</a>
							</li>
						))}
					</ul>
				</section>
			)}
			{istLive(termin) && <Ticker ereignisse={ticker} kreis={kreis.slug} terminId={termin.id} titel={`Zuletzt in ${behoerde.kurz}`} />}
		</div>
	</div>
</Layout>
