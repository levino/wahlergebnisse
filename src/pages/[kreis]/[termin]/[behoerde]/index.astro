---
/** Übersicht einer Behörde: alle Wahlen dort mit Kurzergebnis. */
import Layout from "../../../../layouts/Layout.astro";
import Balken from "../../../../components/Balken.astro";
import Fortschritt from "../../../../components/Fortschritt.astro";
import Ticker from "../../../../components/Ticker.astro";
import { terminById, praesentationUrl } from "../../../../data/termine.ts";
import { kreisBySlug } from "../../../../data/kreise.ts";
import {
	behoerdeImKreis,
	terminPfad,
	wahlPfad,
} from "../../../../lib/pfade.ts";
import {
	ereignisse,
	ergebnis,
	wahleintraege,
} from "../../../../lib/abfragen.ts";
import { parteiFarbe } from "../../../../lib/farben.ts";
import { istKreiswahl } from "../../../../lib/wahltyp.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const termin = terminById(Astro.params.termin ?? "");
const behoerde = kreis
	? behoerdeImKreis(kreis, Astro.params.behoerde ?? "")
	: undefined;
if (!kreis || !termin || !behoerde)
	return new Response("Nicht gefunden", { status: 404 });
const wahlen = wahleintraege(termin.id, behoerde.ags).map((w) => ({
	w,
	e: ergebnis(termin.id, behoerde.ags, w.wahlId, w.gebietId),
}));
const gruppen = [
	{
		titel:
			behoerde.art === "kreis"
				? "Kreisebene"
				: "Kreisweite Wahlen in " + behoerde.kurz,
		eintraege: wahlen.filter((x) => istKreiswahl(x.w.typ)),
	},
	{
		titel: "Gemeindeebene",
		eintraege: wahlen.filter(
			(x) => !istKreiswahl(x.w.typ) && x.w.typ !== "ortsrat",
		),
	},
	{ titel: "Ortsräte", eintraege: wahlen.filter((x) => x.w.typ === "ortsrat") },
].filter((g) => g.eintraege.length);
const label = (w: (typeof wahlen)[number]["w"]) =>
	w.typ === "ortsrat"
		? `Ortsrat ${w.gebietTitel.replace(/^Ortschaft /, "")}`
		: w.slug.startsWith("rat-")
			? `Rat ${w.gebietTitel}`
			: w.kurz;
const ticker = termin.live ? ereignisse(termin.id, 20, behoerde.ags) : [];
// Wurzel der Präsentation: die der Behörde, sonst die des Kreises.
const quelle = praesentationUrl(
	termin,
	behoerde.ags,
	behoerde.wurzel ?? kreis.basis,
);
---

<Layout title={`${behoerde.name} – ${termin.titel}`} termin={termin} kreis={kreis} pfad={[{ titel: termin.titel, href: terminPfad(kreis.slug, termin.id) }, { titel: behoerde.name }]}>
	<h1 class="text-3xl font-bold">{behoerde.name}</h1>
	<p class="opacity-80 mb-6">{termin.titel} · <a class="underline" href={quelle} target="_blank" rel="noopener">amtliche Präsentation</a></p>

	{wahlen.length === 0 && <p class="bg-base-100 p-6">Für diese Behörde liegen noch keine Daten vor.</p>}

	<div class="grid gap-4 xl:grid-cols-3">
		<div class="xl:col-span-2 space-y-6">
			{gruppen.map((g) => (
				<section>
					<h2 class="font-bold text-xl mb-2">{g.titel}</h2>
					<div class="grid gap-4 md:grid-cols-2">
						{g.eintraege.map(({ w, e }) => (
							<article class="bg-base-100 p-4 flex flex-col">
								<h3 class="font-bold text-lg"><a href={wahlPfad(kreis.slug, termin.id, behoerde.slug, w.slug)} class="hover:underline">{label(w)}</a></h3>
								<Fortschritt anz={e?.standAnz} max={e?.standMax} klein />
								<div class="mt-2 flex-1">
									<Balken balken={(e?.ergebnis.parteien ?? []).slice(0, 5).map((p) => ({ ...p, farbe: parteiFarbe(p.key, p.farbe) }))} personenwahl={e?.ergebnis.personenwahl ?? false} kompakt />
								</div>
								{e?.ergebnis.sitze && <p class="text-xs opacity-70 mt-2">{e.ergebnis.sitze.gesamt} Sitze vergeben</p>}
							</article>
						))}
					</div>
				</section>
			))}
		</div>
		<div>{termin.live && <Ticker ereignisse={ticker} kreis={kreis.slug} terminId={termin.id} titel={`Zuletzt in ${behoerde.kurz}`} />}</div>
	</div>
</Layout>
