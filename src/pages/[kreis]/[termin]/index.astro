---
import Layout from "../../../layouts/Layout.astro";
import TerminUebersicht from "../../../components/TerminUebersicht.astro";
import KreisOhneDaten from "../../../components/KreisOhneDaten.astro";
import {
	behoerdenMitTermin,
	terminById,
	terminGiltFuerKreis,
} from "../../../data/termine.ts";
import { kreisBySlug } from "../../../data/kreise.ts";
import { kreisVorhanden } from "../../../lib/abfragen.ts";
import { behoerdePfad } from "../../../lib/pfade.ts";

export const prerender = false;
const kreis = kreisBySlug(Astro.params.kreis ?? "");
const termin = terminById(Astro.params.termin ?? "");
if (!kreis || !termin) return Astro.rewrite("/404");
// Diese Seite zeigt einen Wahltag über das ganze Kreisgebiet: Landrat,
// Kreistag, Fortschritt aller Gemeinden. Einen Termin, den die Kreisbehörde
// gar nicht führt, kann sie deshalb nicht zeigen – sie stand vorher mit einer
// Überschrift „Betroffene Kommunen“ da und nannte keine einzige.
//
// Zwei Ausgänge statt einem: Führt genau **eine** Wahlleitung den Termin (39
// der 47 Fälle – eine Gemeinde hat an dem Tag ihren Bürgermeister gewählt,
// sonst niemand), ist die gemeinte Seite eindeutig, und die Adresse führt
// dorthin weiter. Sie war eine Weile im Umlauf, und ein Umweg ist besser als
// eine Sackgasse. Führen ihn mehrere (acht Fälle), meint die Adresse keine
// bestimmte Seite – dann 404 wie bei jedem unbekannten Termin.
if (!terminGiltFuerKreis(termin, kreis.slug)) {
	const traeger = behoerdenMitTermin(termin, kreis);
	if (traeger.length !== 1) return Astro.rewrite("/404");
	return Astro.redirect(
		behoerdePfad(kreis.slug, termin.id, traeger[0].slug),
		302,
	);
}
---

{/*
	Nicht `kreis.vorhanden`: Das ist die Ausgangsannahme vom Tag der Erhebung.
	Wer erst am Wahlabend freischaltet (Region Hannover, Salzgitter), hätte hier
	sonst weiter „liegt nicht vor“ stehen, während die Startseite des Kreises
	längst Zahlen zeigt. Maßgeblich ist, was in der Datenbank steht.
*/}
{kreisVorhanden(kreis) ? (
	<Layout title={termin.titel} termin={termin} kreis={kreis}>
		<TerminUebersicht termin={termin} kreis={kreis} />
	</Layout>
) : (
	<Layout title={kreis.kurz} termin={termin} kreis={kreis}>
		<KreisOhneDaten kreis={kreis} />
	</Layout>
)}
